---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Drowned from "@/components/scenes/Drowned.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main id="main-content" class="app-layout lost">
    <p class="label label-wide">Lost</p>
    <h1>404</h1>
    <p class="msg">{t.notFound.message}</p>
    <a href={getRelativeLocaleUrl(locale, "")} class="label home">
      {t.notFound.goHome}
    </a>
  </main>

  <Drowned />

  <Footer />
</Layout>

<style>
  /* You have gone somewhere that no longer exists. Read once, then leave. */
  .lost {
    flex: 1;
    padding-block: clamp(60px, 14vh, 130px) clamp(50px, 9vh, 100px);
  }

  .lost h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(64px, 16vw, 150px);
    line-height: 1;
    letter-spacing: 0.1em;
    color: var(--text-3);
    margin: clamp(24px, 4vh, 44px) 0 0;
  }

  .lost .msg {
    margin: clamp(24px, 4vh, 40px) 0 0;
    max-width: 40ch;
    color: var(--text-3);
    font-size: 19.5px;
    line-height: 1.8;
  }

  .lost .home {
    display: inline-block;
    margin-top: clamp(32px, 5vh, 56px);
    color: var(--text-3);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 4px;
  }

  .lost .home:hover {
    color: var(--torch);
    border-bottom-color: var(--torch-dim);
  }
</style>
