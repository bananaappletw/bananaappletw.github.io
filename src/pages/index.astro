---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />

  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    {/* The entrance. Almost nothing here — the scale is the content. */}
    <section class="gate">
      <p class="label label-wide">{config.site.author}</p>
      <h1>The journey matters more than the destination.</h1>
    </section>

    <hr class="rule" />

    {
      featuredPosts.length > 0 && (
        <section class="shelf">
          <h2 class="label label-wide">{t.home.featured}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section class="shelf">
          <h2 class="label label-wide">{t.home.recentPosts}</h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <a class="deeper" href={getRelativeLocaleUrl(locale, "posts")}>
      {t.home.allPosts}
    </a>
  </main>

  <Footer />
</Layout>

<style>
  .gate {
    padding-block: clamp(56px, 12vh, 120px) clamp(44px, 8vh, 84px);
  }

  .gate h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(29px, 4.6vw, 42px);
    line-height: 1.22;
    letter-spacing: 0.03em;
    font-variant-caps: small-caps;
    color: var(--text);
    margin: clamp(18px, 3vh, 30px) 0 0;
    max-width: 22ch;
    text-wrap: balance;
  }

  .shelf {
    padding-block: clamp(40px, 6vh, 68px) 0;
  }

  .shelf h2 {
    margin: 0 0 6px;
  }

  .shelf ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* The way further in. A word, not a button. */
  .deeper {
    display: inline-block;
    margin-block: clamp(48px, 8vh, 88px) 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 4px;
  }

  .deeper:hover {
    color: var(--torch);
    border-bottom-color: var(--torch-dim);
  }
</style>
