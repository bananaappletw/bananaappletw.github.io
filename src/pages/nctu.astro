---
/**
 * /nctu — a keyboard-driven slide deck, built to be projected from a laptop.
 *
 * Deliberately not wrapped in `Layout.astro`: a deck wants the whole viewport,
 * no header, no footer, no scroll and no view-transition router taking over
 * the arrow keys. It still imports the site's stylesheet, so every colour
 * comes from `docs/theme/tokens.json` like everywhere else.
 *
 * Content lives in `src/data/nctu-slides.ts`. Nothing here needs editing to
 * change the questions.
 */
import { Font } from "astro:assets";
import { getAssetPath } from "@/utils/withBase";
import { moon, sunCore, sunRays } from "@/utils/marks";
import { slides } from "@/data/nctu-slides";
import "@/styles/global.css";

/** Running count so questions get a number without hand-typing one. */
let riddleNo = 0;
let questionNo = 0;
const numbered = slides.map(slide => {
  if (slide.kind === "riddle") return { slide, label: `猜謎 ${++riddleNo}` };
  if (slide.kind === "question")
    return { slide, label: `題目 ${++questionNo}` };
  return { slide, label: "" };
});

/**
 * With options, `answer` is a letter. Resolve it to an index so the right row
 * can be marked, and to "B. CSIE" so the reveal reads on its own from the back
 * of the room — a lone letter does not.
 */
const resolveAnswer = (answer: string, options?: string[]) => {
  if (!options) return { index: -1, text: answer };
  const index = answer.trim().toUpperCase().charCodeAt(0) - 65;
  const option = options[index];
  return option === undefined
    ? { index: -1, text: answer }
    : { index, text: `${String.fromCharCode(65 + index)}. ${option}` };
};

/** Overview list needs one short name per slide. */
const tocTitle = (slide: (typeof slides)[number], label: string) => {
  switch (slide.kind) {
    case "cover":
    case "section":
      return slide.title;
    case "agenda":
      return slide.title ?? "流程";
    case "bingo":
      return slide.title ?? "賓果卡";
    case "text":
      return slide.title ?? slide.body[0];
    default:
      return `${label} — ${slide.prompt}`;
  }
};
---

<!doctype html>
<html lang="zh-Hant" data-theme="hollowed">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <title>NCTU Alumni at Tokyo · 賓果與猜謎</title>
    <Font
      cssVariable="--font-display"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font cssVariable="--font-body" />

    <!--
      Same contract as Layout.astro: localStorage decides, hollowed is the
      default. Inline and before paint, or the deck flashes the wrong world
      onto the projector at the start of the event.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("world");
        const world =
          stored === "kindled" || stored === "hollowed" ? stored : "hollowed";
        document.firstElementChild?.setAttribute("data-theme", world);
      })();
    </script>
  </head>

  <body class="deck">
    <div class="rail"><span class="rail-fill" id="rail"></span></div>

    <button
      id="world-btn"
      type="button"
      aria-label="Dark theme. Switch to light."
    >
      <svg
        class="world-icon"
        viewBox="0 0 64 64"
        width="20"
        height="20"
        aria-hidden="true"
        focusable="false"
      >
        <path class="moon" d={moon}></path>
        <g class="sun">
          <path d={sunCore}></path>
          {sunRays.map(d => <path d={d} />)}
        </g>
      </svg>
    </button>

    <main id="stage">
      {
        numbered.map(({ slide, label }, i) => (
          <section class="slide" data-i={i} data-kind={slide.kind}>
            <div class="inner">
              {slide.kind === "cover" && (
                <>
                  <h1 class="cover-title">{slide.title}</h1>
                  {slide.subtitle && <p class="cover-sub">{slide.subtitle}</p>}
                  {slide.note && <p class="cover-note">{slide.note}</p>}
                </>
              )}

              {slide.kind === "section" && (
                <>
                  {slide.label && <p class="eyebrow">{slide.label}</p>}
                  <h2 class="section-title">{slide.title}</h2>
                  {slide.body && (
                    <ul class="rules">
                      {slide.body.map(line => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  )}
                </>
              )}

              {slide.kind === "agenda" && (
                <>
                  {slide.title && <h2 class="head">{slide.title}</h2>}
                  <ol class="agenda">
                    {slide.rows.map(row => (
                      <li>
                        <span class="when">{row.time}</span>
                        <span class="what">
                          {row.item}
                          {row.note && <span class="who">{row.note}</span>}
                        </span>
                      </li>
                    ))}
                  </ol>
                </>
              )}

              {slide.kind === "text" && (
                <>
                  {slide.title && <h2 class="head">{slide.title}</h2>}
                  <ul class="bullets">
                    {slide.body.map((line, n) => (
                      <li data-step={slide.revealBullets ? n + 1 : undefined}>
                        {line}
                      </li>
                    ))}
                  </ul>
                </>
              )}

              {slide.kind === "bingo" && (
                <>
                  {slide.title && <h2 class="head">{slide.title}</h2>}
                  <div
                    class="bingo"
                    style={`--cols:${Math.max(...slide.rows.map(r => r.length))}`}
                  >
                    {slide.rows.flatMap(row =>
                      row.map(cell => (
                        <span class:list={["cell", { free: cell === "FREE" }]}>
                          {cell}
                        </span>
                      )),
                    )}
                  </div>
                </>
              )}

              {slide.kind === "riddle" && (
                <>
                  <p class="eyebrow">{slide.index ?? label}</p>
                  <p class="prompt">{slide.prompt}</p>
                  {slide.hint && (
                    <p class="hint" data-step="1">
                      <span class="tag">提示</span>
                      {slide.hint}
                    </p>
                  )}
                  <div class="answer" data-step={slide.hint ? "2" : "1"}>
                    <p class="answer-text">{slide.answer}</p>
                    {slide.explain && <p class="explain">{slide.explain}</p>}
                  </div>
                </>
              )}

              {slide.kind === "question" &&
                (() => {
                  const answer = resolveAnswer(slide.answer, slide.options);
                  return (
                    <>
                      <p class="eyebrow">{slide.index ?? label}</p>
                      <p class="prompt">{slide.prompt}</p>
                      {slide.image && (
                        <img
                          class="shot"
                          src={getAssetPath(slide.image)}
                          alt=""
                          loading="eager"
                        />
                      )}
                      {slide.options && (
                        <ol class="options">
                          {slide.options.map((opt, n) => (
                            <li
                              class:list={{ "is-correct": n === answer.index }}
                            >
                              {opt}
                            </li>
                          ))}
                        </ol>
                      )}
                      <div class="answer" data-step="1">
                        <p class="answer-text">{answer.text}</p>
                        {slide.explain && (
                          <p class="explain">{slide.explain}</p>
                        )}
                      </div>
                    </>
                  );
                })()}
            </div>
          </section>
        ))
      }
    </main>

    <footer class="hud">
      <span id="counter">1 / {slides.length}</span>
      <span class="hud-keys">→ 下一步 · O 目錄 · ? 說明</span>
    </footer>

    <div class="overlay" id="toc" hidden>
      <ol class="toc-list">
        {
          numbered.map(({ slide, label }, i) => (
            <li>
              <button type="button" data-jump={i}>
                <span class="toc-n">{i + 1}</span>
                <span class="toc-t">{tocTitle(slide, label)}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="overlay" id="help" hidden>
      <dl class="keys">
        <dt>→ ↓ 空白鍵 Enter PageDown</dt><dd>下一步</dd>
        <dt>← ↑ Backspace PageUp</dt><dd>上一步</dd>
        <dt>Home / End</dt><dd>第一頁 / 最後一頁</dd>
        <dt>數字 + Enter</dt><dd>跳到該頁</dd>
        <dt>F</dt><dd>全螢幕</dd>
        <dt>B</dt><dd>黑屏（再按一次回來）</dd>
        <dt>T · 右上角按鈕</dt><dd>開燈／關燈</dd>
        <dt>O</dt><dd>目錄</dd>
        <dt>Esc</dt><dd>關閉浮層</dd>
      </dl>
    </div>

    <div class="blackout" id="blackout" hidden></div>

    <style>
      /* The deck owns the viewport. global.css sizes body for reading; a
         projected slide is sized against the smaller viewport axis instead,
         so one rule scales the whole deck from a laptop to a 4K projector. */
      html,
      body.deck {
        height: 100%;
        overflow: hidden;
      }

      body.deck {
        margin: 0;
        background: var(--ground);
        color: var(--text-2);
        /* Cardo carries no CJK, so name the fallbacks rather than leaving the
           choice to whatever the projector laptop happens to have first. The
           Japanese faces come after the Traditional Chinese ones and before
           the generic serif: the questions contain kanji a TC face does not
           ship (区 in 中野区), which otherwise lands on tofu. */
        font-family:
          var(--font-body), "Noto Serif TC", "Source Han Serif TC",
          "PingFang TC", "Microsoft JhengHei", "Hiragino Mincho ProN",
          "Yu Mincho", "Noto Serif JP", serif;
        font-size: min(2.5vw, 4.4vh);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      /* Block, not grid. As a grid item a slide's `height: 100%` resolves
         against an auto-sized row — which is sized by the slide's own content,
         so a tall slide grew the row and reported itself as fitting while it
         ran off the screen. A plain block child of a fixed, inset-0 parent has
         a definite height to measure against. */
      #stage {
        position: fixed;
        inset: 0;
      }

      .slide {
        display: none;
        width: 100%;
        height: 100%;
        place-items: center;
        padding: 6vh 8vw;
        box-sizing: border-box;
      }

      .slide.is-current {
        display: grid;
      }

      /* `--fit` is set by the script: a slide whose content is taller than the
         viewport shrinks until it fits, rather than running off the bottom
         where a projector simply loses it. Everything inside sizes in `em`,
         so scaling this one value scales the whole slide together. */
      .inner {
        width: min(100%, 46em);
        font-size: calc(1em * var(--fit, 1));
        text-align: center;
      }

      /* The bingo card is a wide object; give it the room the questions
         deliberately do not take. */
      .slide[data-kind="bingo"] .inner {
        width: min(100%, 74em);
      }

      /* Reveal steps. Hidden ones keep their box so the slide does not jump
         when the answer appears — the single most distracting thing a deck
         can do mid-question. */
      [data-step] {
        opacity: 0;
        transform: translateY(0.25em);
        transition:
          opacity 240ms ease,
          transform 240ms ease;
      }

      [data-step].is-shown {
        opacity: 1;
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        [data-step] {
          transform: none;
          transition: none;
        }
      }

      .eyebrow {
        margin: 0 0 1.2em;
        font-size: 0.62em;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--text-4);
      }

      .cover-title {
        margin: 0;
        font-family: var(--font-display), serif;
        font-size: 2.6em;
        line-height: 1.15;
        color: var(--text);
      }

      .cover-sub {
        margin: 0.6em 0 0;
        font-size: 1.05em;
        letter-spacing: 0.08em;
        color: var(--text-3);
      }

      .cover-note {
        margin: 3em 0 0;
        font-size: 0.6em;
        letter-spacing: 0.06em;
        color: var(--text-4);
      }

      .section-title {
        margin: 0;
        font-family: var(--font-display), serif;
        font-size: 2.2em;
        color: var(--text);
      }

      .rules {
        margin: 1.8em 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.35em;
        font-size: 0.72em;
        color: var(--text-3);
      }

      .head {
        margin: 0 0 1em;
        font-family: var(--font-display), serif;
        font-size: 1.4em;
        color: var(--text);
      }

      .prompt {
        margin: 0;
        font-size: 1.5em;
        line-height: 1.45;
        color: var(--text);
        text-wrap: balance;
      }

      /* Sized in `em`, not `vh`, so the fit pass scales the photo along with
         the text instead of leaving it the one thing that still overflows. */
      .shot {
        display: block;
        margin: 1.1em auto 0;
        max-width: min(100%, 19em);
        max-height: 8.5em;
        width: auto;
        height: auto;
        border: 1px solid var(--border);
        object-fit: contain;
      }

      .hint {
        margin: 1.4em 0 0;
        font-size: 0.8em;
        color: var(--text-3);
      }

      .tag {
        margin-inline-end: 0.7em;
        padding: 0.15em 0.7em;
        border: 1px solid var(--border);
        border-radius: 999px;
        font-size: 0.8em;
        letter-spacing: 0.14em;
        color: var(--text-4);
      }

      .options {
        margin: 1.8em auto 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.55em;
        width: min(100%, 30em);
        text-align: start;
        counter-reset: opt;
      }

      .options li {
        counter-increment: opt;
        padding: 0.4em 0.9em;
        border-inline-start: 2px solid var(--border);
        color: var(--text-2);
        transition:
          opacity 240ms ease,
          color 240ms ease;
      }

      .options li::before {
        content: counter(opt, upper-alpha) ".";
        margin-inline-end: 0.7em;
        color: var(--text-4);
      }

      /* Once the answer is up, the wrong options recede rather than vanish —
         the group still wants to see what it argued about. */
      .inner:has(.answer.is-shown) .options li:not(.is-correct) {
        opacity: 0.34;
      }

      .inner:has(.answer.is-shown) .options li.is-correct {
        border-inline-start-color: var(--torch-dim);
        color: var(--text);
      }

      /* The run of show. Times are a fixed column so the eye can run down
         them; the segment and who is doing it sit together to its right. */
      .agenda {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.5em;
        width: min(100%, 34em);
        margin-inline: auto;
        font-size: 0.78em;
        text-align: start;
      }

      .agenda li {
        display: grid;
        grid-template-columns: 4.6em 1fr;
        gap: 1.4em;
        align-items: baseline;
        padding-bottom: 0.5em;
        border-bottom: 1px solid var(--border);
      }

      .agenda li:last-child {
        border-bottom: 0;
      }

      .when {
        color: var(--text-4);
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.06em;
      }

      .what {
        color: var(--text);
      }

      .who {
        display: block;
        margin-top: 0.15em;
        font-size: 0.76em;
        color: var(--text-3);
      }

      .bullets {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.8em;
        text-align: start;
      }

      .bullets li {
        padding-inline-start: 1.2em;
        position: relative;
        color: var(--text-2);
      }

      .bullets li::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        top: 0.62em;
        width: 0.34em;
        height: 0.34em;
        background: var(--ornament);
        transform: rotate(45deg);
      }

      .bingo {
        display: grid;
        grid-template-columns: repeat(var(--cols, 5), 1fr);
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        font-size: 0.46em;
        line-height: 1.4;
      }

      .cell {
        display: grid;
        place-items: center;
        min-height: 5.4em;
        padding: 0.8em 0.6em;
        background: var(--ground);
        color: var(--text-2);
        text-wrap: balance;
      }

      .cell.free {
        background: var(--panel);
        color: var(--text-4);
        letter-spacing: 0.18em;
      }

      /* The one gold moment on the slide. Nothing else here is --torch, which
         is what makes the reveal land. */
      .answer {
        margin: 2em auto 0;
        padding: 1.1em 1.4em;
        width: fit-content;
        max-width: 100%;
        border: 1px solid color-mix(in oklab, var(--torch) 34%, transparent);
        background: var(--torch-tint);
      }

      .answer-text {
        margin: 0;
        font-size: 1.25em;
        color: var(--torch);
      }

      .explain {
        margin: 0.7em 0 0;
        font-size: 0.62em;
        line-height: 1.7;
        color: var(--text-3);
        text-align: start;
      }

      /* Progress rail, HUD and overlays --------------------------------- */

      .rail {
        position: fixed;
        inset: 0 0 auto;
        height: 2px;
        background: color-mix(in oklab, var(--border) 60%, transparent);
        z-index: 3;
      }

      .rail-fill {
        display: block;
        height: 100%;
        width: 0;
        background: var(--torch-dim);
        transition: width 200ms ease;
      }

      .hud {
        position: fixed;
        inset: auto 0 0;
        display: flex;
        justify-content: space-between;
        padding: 1.1vh 2vw;
        font-size: 0.52em;
        letter-spacing: 0.1em;
        color: var(--text-4);
        z-index: 3;
      }

      .hud-keys {
        opacity: 0;
        transition: opacity 200ms ease;
      }

      body:hover .hud-keys {
        opacity: 1;
      }

      /* Lights. Top right, dim until you go looking for it — during the talk
         it should read as part of the room's furniture, not as a control
         competing with the slide. */
      #world-btn {
        position: fixed;
        inset: 1.6vh 1.6vw auto auto;
        z-index: 4;
        display: grid;
        place-items: center;
        padding: 0.6em;
        border: 0;
        background: none;
        color: var(--text-4);
        opacity: 0.45;
        transition:
          opacity 200ms ease,
          color 200ms ease;
      }

      #world-btn:hover,
      #world-btn:focus-visible {
        opacity: 1;
        color: var(--text-2);
      }

      .moon {
        fill: currentColor;
      }

      .sun {
        display: none;
        fill: currentColor;
      }

      :root[data-theme="kindled"] .moon,
      :root[data-theme="light"] .moon {
        display: none;
      }

      :root[data-theme="kindled"] .sun,
      :root[data-theme="light"] .sun {
        display: block;
      }

      .overlay {
        position: fixed;
        inset: 0;
        z-index: 5;
        display: grid;
        place-items: center;
        padding: 8vh 8vw;
        overflow: auto;
        background: color-mix(in oklab, var(--ground) 94%, transparent);
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
      }

      .overlay[hidden] {
        display: none;
      }

      .toc-list {
        margin: 0;
        padding: 0;
        list-style: none;
        width: min(100%, 40em);
        font-size: 0.7em;
      }

      .toc-list button {
        display: flex;
        gap: 1.2em;
        width: 100%;
        padding: 0.45em 0.6em;
        border: 0;
        background: none;
        color: var(--text-2);
        font: inherit;
        text-align: start;
      }

      .toc-list button:hover,
      .toc-list button.is-active {
        background: var(--panel);
        color: var(--text);
      }

      .toc-n {
        min-width: 2em;
        color: var(--text-4);
        text-align: end;
      }

      .toc-t {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .keys {
        display: grid;
        grid-template-columns: auto auto;
        gap: 0.6em 2em;
        margin: 0;
        font-size: 0.62em;
        color: var(--text-3);
      }

      .keys dt {
        color: var(--text-4);
        text-align: end;
      }

      .keys dd {
        margin: 0;
        color: var(--text-2);
      }

      .blackout {
        position: fixed;
        inset: 0;
        z-index: 9;
        background: var(--ground);
      }

      .blackout[hidden] {
        display: none;
      }

      /* Type shrinks on a phone so a slide still fits without scrolling. */
      @media (max-width: 640px) {
        body.deck {
          font-size: 4.2vw;
        }

        .slide {
          padding: 6vh 6vw;
        }

        .bingo {
          font-size: 0.34em;
        }
      }

      @media print {
        html,
        body.deck {
          overflow: visible;
          height: auto;
        }

        .slide,
        .slide.is-current {
          display: grid;
          break-after: page;
          height: 100vh;
        }

        [data-step] {
          opacity: 1;
          transform: none;
        }

        .rail,
        .hud,
        .overlay,
        .blackout,
        #world-btn {
          display: none;
        }
      }
    </style>

    <script>
      const slides = Array.from(
        document.querySelectorAll<HTMLElement>(".slide"),
      );
      const rail = document.getElementById("rail")!;
      const counter = document.getElementById("counter")!;
      const toc = document.getElementById("toc")!;
      const help = document.getElementById("help")!;
      const blackout = document.getElementById("blackout")!;

      /**
       * Lights. Same localStorage key as the rest of the site, so a world
       * chosen here is the one the blog opens in and the other way round.
       * The deck re-fits after a flip: the two worlds do not set type at
       * identical weights, and a slide that just fit can stop fitting.
       */
      const worldBtn = document.getElementById("world-btn")!;

      function reflectWorld(world: "hollowed" | "kindled") {
        document.firstElementChild?.setAttribute("data-theme", world);
        worldBtn.setAttribute(
          "aria-label",
          world === "kindled"
            ? "Light theme. Switch to dark."
            : "Dark theme. Switch to light.",
        );
      }

      function flipWorld() {
        const next =
          localStorage.getItem("world") === "kindled" ? "hollowed" : "kindled";
        localStorage.setItem("world", next);
        reflectWorld(next);
        fit(slides[i]);
      }

      worldBtn.addEventListener("click", flipWorld);

      /** Reveal steps per slide: the highest `data-step` it declares. */
      const stepsOf = (slide: HTMLElement) =>
        Array.from(slide.querySelectorAll<HTMLElement>("[data-step]")).reduce(
          (max, el) => Math.max(max, Number(el.dataset.step ?? 0)),
          0,
        );

      /**
       * Shrink a slide until it fits the viewport.
       *
       * A slide is measured with every reveal step laid out — hidden steps
       * keep their box — so the scale is chosen once and does not change when
       * the answer appears. Without this, the long questions ran off the
       * bottom of the screen and the answer was simply never visible.
       */
      function fit(slide: HTMLElement) {
        const inner = slide.querySelector<HTMLElement>(".inner");
        if (!inner) return;
        const style = getComputedStyle(slide);
        const room =
          slide.clientHeight -
          parseFloat(style.paddingTop) -
          parseFloat(style.paddingBottom);

        let scale = 1;
        inner.style.setProperty("--fit", "1");
        while (inner.scrollHeight > room && scale > 0.45) {
          scale -= 0.04;
          inner.style.setProperty("--fit", scale.toFixed(2));
        }
      }

      let i = 0;
      let step = 0;
      /** Digits typed so far, for "7 Enter" jumps. */
      let typed = "";

      function render() {
        slides.forEach((slide, n) => {
          slide.classList.toggle("is-current", n === i);
          if (n !== i) return;
          fit(slide);
          slide.querySelectorAll<HTMLElement>("[data-step]").forEach(el => {
            el.classList.toggle(
              "is-shown",
              Number(el.dataset.step ?? 0) <= step,
            );
          });
        });

        counter.textContent = `${i + 1} / ${slides.length}`;
        rail.style.width =
          slides.length > 1 ? `${(i / (slides.length - 1)) * 100}%` : "100%";

        toc.querySelectorAll<HTMLElement>("[data-jump]").forEach(b => {
          b.classList.toggle("is-active", Number(b.dataset.jump) === i);
        });

        // Replace rather than push: holding → should not fill the history
        // stack, or Back becomes useless for leaving the deck. The step rides
        // in the hash too ("#11.1"), so reloading mid-question — the projector
        // dropped out, the laptop slept — comes back exactly where it was.
        history.replaceState(
          null,
          "",
          `#${i + 1}${step > 0 ? `.${step}` : ""}`,
        );
      }

      function go(n: number, atEnd = false) {
        i = Math.max(0, Math.min(slides.length - 1, n));
        step = atEnd ? stepsOf(slides[i]) : 0;
        render();
      }

      function next() {
        if (step < stepsOf(slides[i])) step += 1;
        else if (i < slides.length - 1) return go(i + 1);
        render();
      }

      function prev() {
        if (step > 0) step -= 1;
        else if (i > 0) return go(i - 1, true);
        render();
      }

      function closeOverlays() {
        toc.hidden = true;
        help.hidden = true;
      }

      function toggle(el: HTMLElement) {
        const opening = el.hidden;
        closeOverlays();
        el.hidden = !opening;
      }

      document.addEventListener("keydown", event => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const key = event.key;

        if (key >= "0" && key <= "9") {
          typed += key;
          return;
        }
        if (key === "Enter" && typed) {
          const target = Number(typed) - 1;
          typed = "";
          closeOverlays();
          go(target);
          event.preventDefault();
          return;
        }
        typed = "";

        switch (key) {
          case "ArrowRight":
          case "ArrowDown":
          case "PageDown":
          case " ":
          case "Enter":
          case "n":
            if (!toc.hidden || !help.hidden) closeOverlays();
            else next();
            event.preventDefault();
            break;
          case "ArrowLeft":
          case "ArrowUp":
          case "PageUp":
          case "Backspace":
          case "p":
            if (!toc.hidden || !help.hidden) closeOverlays();
            else prev();
            event.preventDefault();
            break;
          case "Home":
            go(0);
            event.preventDefault();
            break;
          case "End":
            go(slides.length - 1, true);
            event.preventDefault();
            break;
          case "f":
            if (document.fullscreenElement) document.exitFullscreen();
            else document.documentElement.requestFullscreen?.();
            break;
          case "b":
          case ".":
            blackout.hidden = !blackout.hidden;
            break;
          case "t":
            flipWorld();
            break;
          case "o":
            toggle(toc);
            break;
          case "?":
          case "/":
            toggle(help);
            break;
          case "Escape":
            closeOverlays();
            blackout.hidden = true;
            break;
        }
      });

      // Click/tap the right half to advance, left half to go back — a wireless
      // clicker that sends mouse buttons behaves like the arrow keys do.
      document.getElementById("stage")!.addEventListener("click", event => {
        if (event.clientX > window.innerWidth / 2) next();
        else prev();
      });

      toc.addEventListener("click", event => {
        const button = (event.target as HTMLElement).closest<HTMLElement>(
          "[data-jump]",
        );
        if (!button) return;
        closeOverlays();
        go(Number(button.dataset.jump));
      });

      // Re-measure whenever the box the deck is measured against changes:
      // entering fullscreen, plugging in the projector, the late arrival of a
      // webfont that is wider than the fallback it replaced.
      addEventListener("resize", () => fit(slides[i]));
      document.fonts?.ready.then(() => fit(slides[i]));
      // A photo has no height until it decodes, so the first measurement of a
      // slide carrying one is taken against an empty box.
      document.querySelectorAll("img").forEach(img => {
        img.addEventListener("load", () => fit(slides[i]));
      });

      const [hashSlide, hashStep] = location.hash.slice(1).split(".");
      go(Number(hashSlide) > 0 ? Number(hashSlide) - 1 : 0);
      if (hashStep) {
        step = Math.min(Number(hashStep) || 0, stepsOf(slides[i]));
        render();
      }
    </script>
  </body>
</html>
