---
import { useTranslations } from "@/i18n";
import { flame, bonfireAsh } from "@/utils/marks";

const t = useTranslations(Astro.currentLocale);
---

{
  /*
  The bonfire. A Souls bonfire is where you rest and return, which is exactly
  what a back-to-top control does — so it is drawn as one rather than as an
  arrow: a coiled sword driven into a mound of ash, with the flame above it.

  It sits bottom-right, its ring is scroll progress, and it carries one of the
  page's rare gold moments. The sword and ash are drawn in the ornament
  channel, so they go to bone when the world is hollowed; only the flame is
  gold.
*/
}
<button
  id="bonfire"
  type="button"
  aria-label={t.post.backToTop}
  title={t.post.backToTop}
>
  <span class="ring" aria-hidden="true"></span>

  <svg
    class="fire"
    viewBox="0 0 96 96"
    width="24"
    height="24"
    aria-hidden="true"
  >
    {/* the coiled sword driven point-down into the ash, and its mound */}
    <g class="ash">{bonfireAsh.map(d => <path d={d} />)}</g>
    {
      /* three tongues — the fire is as much the dark between them as the gold */
    }
    <g class="flame">{flame.map(d => <path d={d} />)}</g>
  </svg>

  <span class="sr-only">{t.post.backToTop}</span>
</button>

<style>
  #bonfire {
    position: fixed;
    inset-inline-end: clamp(16px, 4vw, 34px);
    inset-block-end: clamp(16px, 4vw, 34px);
    z-index: 40;

    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    padding: 0;
    border: 0;
    background: none;

    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
  }

  #bonfire.lit {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Scroll progress, drawn as the ring of ash around the fire. The gradient
     is set from script; the mask turns the disc into a hairline ring. */
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: conic-gradient(
      var(--torch-dim),
      var(--torch-dim) 0%,
      transparent 0%
    );
    /* A mask reads alpha, not hue, so `black` here is structural rather than
       a palette colour — it is what turns the disc into a hairline ring. */
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2px),
      black calc(100% - 2px)
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2px),
      black calc(100% - 2px)
    );
    opacity: 0.8;
  }

  .fire {
    position: relative;
    overflow: visible;
  }

  /* Only the flame is gold. Sword and ash read from the ornament channel,
     so they go to bone when the world is hollowed. Both are filled, not
     stroked — see src/utils/nib.ts. */
  .flame {
    fill: var(--torch);
  }

  .ash {
    fill: var(--ornament);
  }

  #bonfire:hover .flame {
    fill: var(--torch);
    filter: brightness(1.15);
  }

  @media (prefers-reduced-motion: no-preference) {
    #bonfire.lit .flame {
      transform-origin: 12px 16px;
      animation: bonfire-flicker 3.8s ease-in-out infinite;
    }

    @keyframes bonfire-flicker {
      0%,
      100% {
        opacity: 1;
        transform: scaleY(1);
      }
      37% {
        opacity: 0.72;
        transform: scaleY(0.94);
      }
      62% {
        opacity: 0.94;
        transform: scaleY(1.03);
      }
    }
  }
</style>

<script is:inline data-astro-rerun>
  function setupBonfire() {
    const root = document.documentElement;
    const bonfire = document.querySelector("#bonfire");
    const ring = bonfire?.querySelector(".ring");
    if (!bonfire || !ring) return;

    bonfire.addEventListener("click", () => {
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    });

    let wasLit = null;

    function onScroll() {
      const total = root.scrollHeight - root.clientHeight;

      // On a page too short to scroll there is nothing to return to, so the
      // fire stays out rather than sitting there doing nothing.
      if (total <= 40) {
        bonfire.classList.remove("lit");
        wasLit = false;
        return;
      }

      const progress = Math.min(
        100,
        Math.round((root.scrollTop / total) * 100),
      );
      ring.style.setProperty(
        "background-image",
        `conic-gradient(var(--torch-dim), var(--torch-dim) ${progress}%, transparent ${progress}%)`,
      );

      const lit = root.scrollTop > 120;
      if (lit !== wasLit) {
        bonfire.classList.toggle("lit", lit);
        wasLit = lit;
      }
    }

    let ticking = false;
    document.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        onScroll();
        ticking = false;
      });
    });

    window.addEventListener("resize", onScroll);
    onScroll();
  }

  setupBonfire();
  document.addEventListener("astro:after-swap", setupBonfire);
</script>
