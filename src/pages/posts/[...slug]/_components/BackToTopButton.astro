---
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.currentLocale);
---

{
  /*
  The bonfire. A Souls bonfire is where you rest and return, which is exactly
  what a back-to-top control does — so it is drawn as one rather than as an
  arrow. It sits bottom-right, kindles as you descend through the post (the
  ring is scroll progress), and carries one of the page's rare gold moments.
*/
}
<button
  id="bonfire"
  type="button"
  aria-label={t.post.backToTop}
  title={t.post.backToTop}
>
  <span class="ring" aria-hidden="true"></span>
  <span class="flame" aria-hidden="true">&#9670;</span>
  <span class="sr-only">{t.post.backToTop}</span>
</button>

<style>
  #bonfire {
    position: fixed;
    inset-inline-end: clamp(16px, 4vw, 34px);
    inset-block-end: clamp(16px, 4vw, 34px);
    z-index: 40;

    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 0;
    background: none;

    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
  }

  #bonfire.lit {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Scroll progress, drawn as the ring of ash around the fire. The gradient
     is set from script; the mask turns the disc into a hairline ring. */
  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-image: conic-gradient(
      var(--torch-dim),
      var(--torch-dim) 0%,
      transparent 0%
    );
    /* A mask reads alpha, not hue, so `black` here is structural rather than
       a palette colour — it is what turns the disc into a hairline ring. */
    -webkit-mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2px),
      black calc(100% - 2px)
    );
    mask: radial-gradient(
      farthest-side,
      transparent calc(100% - 2px),
      black calc(100% - 2px)
    );
    opacity: 0.85;
  }

  .flame {
    font-size: 15px;
    line-height: 1;
    color: var(--torch);
    transition: transform 0.18s ease-out;
  }

  #bonfire:hover .flame {
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: no-preference) {
    #bonfire.lit .flame {
      animation: bonfire-flicker 4.2s ease-in-out infinite;
    }

    @keyframes bonfire-flicker {
      0%,
      100% {
        opacity: 1;
      }
      38% {
        opacity: 0.68;
      }
      64% {
        opacity: 0.92;
      }
    }
  }
</style>

<script is:inline data-astro-rerun>
  function setupBonfire() {
    const root = document.documentElement;
    const bonfire = document.querySelector("#bonfire");
    const ring = bonfire?.querySelector(".ring");
    if (!bonfire || !ring) return;

    bonfire.addEventListener("click", () => {
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    });

    let wasLit = null;

    function onScroll() {
      const total = root.scrollHeight - root.clientHeight;
      if (total <= 0) return;

      const progress = Math.min(
        100,
        Math.round((root.scrollTop / total) * 100),
      );
      ring.style.setProperty(
        "background-image",
        `conic-gradient(var(--torch-dim), var(--torch-dim) ${progress}%, transparent ${progress}%)`,
      );

      // The fire only becomes visible once you have gone some way down.
      const lit = root.scrollTop / total > 0.12;
      if (lit !== wasLit) {
        bonfire.classList.toggle("lit", lit);
        wasLit = lit;
      }
    }

    let ticking = false;
    document.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        onScroll();
        ticking = false;
      });
    });

    onScroll();
  }

  setupBonfire();
  document.addEventListener("astro:after-swap", setupBonfire);
</script>
