---
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{
  (prevPost || nextPost) && (
    <nav data-pagefind-ignore class="onward">
      <p class="label label-wide">Further In</p>

      {prevPost && (
        <a href={getPostUrl(prevPost.id, prevPost.filePath, locale)}>
          <span class="label">{t.post.previousPost}</span>
          <span class="t">{prevPost.title}</span>
        </a>
      )}

      {nextPost && (
        <a href={getPostUrl(nextPost.id, nextPost.filePath, locale)}>
          <span class="label">{t.post.nextPost}</span>
          <span class="t">{nextPost.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .onward {
    padding-block: clamp(50px, 9vh, 100px) 0;
  }

  .onward > .label-wide {
    margin: 0 0 6px;
  }

  .onward a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .onward a:last-of-type {
    border-bottom: 0;
  }

  .onward .t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: 0.06em;
    line-height: 1.35;
    color: var(--text-3);
    transition: color 0.18s ease-out;
  }

  .onward a:hover .t {
    color: var(--text);
  }
</style>
