  }

  .sidebar :global(.row dd code) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
  }

  /* Raw on the left, resolved on the right: the one picture of what Jinja
     actually does, and where it does it. */
  .sidebar :global(.row dd .raw) {
    color: var(--arcane);
  }

  .sidebar :global(.row dd .arrow) {
    color: var(--text-4);
  }

  .sidebar :global(.row dd em) {
    display: block;
    margin-top: 3px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-4);
  }

  /* ── the reference panels ──────────────────────────────────────────── */

  .panels {
    display: grid;
    gap: clamp(40px, 7vh, 76px);
    width: 100%;
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: clamp(22px, 6vw, 40px);
    padding-block: clamp(30px, 6vh, 56px) clamp(40px, 8vh, 80px);
    border-top: 1px solid var(--border);
