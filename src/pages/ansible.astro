  }

  .trips li em {
    font-family: var(--font-mono);
    font-size: 11px;
    font-style: normal;
    color: var(--text-4);
    text-align: end;
  }

  /* the ladder */
  .ladder {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    columns: 2;
    column-gap: clamp(22px, 4vw, 48px);
  }

  .ladder li {
    display: grid;
    grid-template-columns: 2.4ch 1fr;
    grid-template-areas: "rung what" ". note";
    gap: 1px 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--border-recess);
    break-inside: avoid;
