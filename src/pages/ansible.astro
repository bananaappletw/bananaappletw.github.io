            })
          }
        </g>

        <!-- Built at runtime: there are thirty-two schedules and the
             reader picks which one is drawn. -->
        <g class="bars"></g>

        <g class="head" aria-hidden="true">
          <line
            class="playhead"
            x1={G_LEFT}
            y1={G_TOP - 12}
            x2={G_LEFT}
            y2={G_H - 14}></line>
