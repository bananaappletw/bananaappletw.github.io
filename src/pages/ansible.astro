---
/**
 * /ansible — one playbook run, simulated.
 *
 * The sibling page, `/network`, follows a request across cables. This
 * follows a playbook across hosts, and it is built the same way and for the
 * same reason: the YAML is the easy half. What nobody can see from the YAML
 * is the SHAPE of the run, and the shape is a schedule.
 *
 * ── three panes, which is a debugger ─────────────────────────────────────
 *
 * Source on the left, execution in the middle, detail on the right. That
 * arrangement is borrowed on purpose: the thing a reader needs is the line
 * of YAML, the moment it ran, and what actually went over the wire, all
 * visible at once. Clicking any one of the three moves the other two.
 *
 * ── the middle pane is two drawings, not one ─────────────────────────────
 *
 * A star shows that this is agentless — one machine holds Ansible and the
 * others hold nothing — and shows which link is busy. A Gantt shows the
 * part a star cannot: that three hosts and two forks means one host always
 * waits, and that the default `linear` strategy puts a barrier after every
 * task, so each row of the run costs what its slowest host costs.
 *
 * The whole future of the run is drawn from the first frame rather than
 * revealed. That is deliberate. A reader cannot see a barrier they have to
 * remember; they can see one they are looking at.
 *
 * ── the clock runs at life size ──────────────────────────────────────────
 *
 * `/network` slows its clock about forty times, because a packet crosses a
 * room in a fifth of a millisecond. Here 1× is real time: seven seconds of
 * run take seven seconds to watch, and two and a half of them are one
 * package manager. Sitting through that is the lesson, so it is the default,
 * and the faster speeds are there for the second viewing.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import {
  BEST_MS,
  CHECK_MODE,
  CHOICES,
  DEFAULTS,
  EVENTS,
  GROUPS,
  HOSTS,
  INVENTORY,
  LINKS,
  LINK_MS,
  MANAGED,
  PLAYBOOK,
  PLAYS,
  PRECEDENCE,
  ROLE_TREE,
  RUN_END,
  SCHEDULE,
  TARGET_MS,
  TASKS,
  VERDICTS,
  WORST_MS,
  buildSchedule,
  type RunOptions,
} from "@/data/ansible-run";

const title = "Ansible";
const description =
  "One ansible-playbook run as a live simulation: the schedule, the forks, the barrier after every task, and what each module actually sends over SSH — with the playbook beside it.";

/* ── the star ──────────────────────────────────────────────────────────── */

const FAN_W = 1000;
const FAN_H = 300;
const fanAt = (n: { x: number; y: number }) => ({
  x: n.x * FAN_W,
  y: n.y * FAN_H,
});
const fanPos = Object.fromEntries(HOSTS.map(h => [h.id, fanAt(h)]));

/* ── the Gantt ─────────────────────────────────────────────────────────── */

const G_W = 1000;
const LANE_H = 44;
const G_TOP = 34;
const G_LEFT = 96;
const G_RIGHT = 988;
const G_H = G_TOP + MANAGED.length * LANE_H + 14;

/**
 * The axis is fixed to the SLOWEST configuration the page offers, not to the
 * run currently drawn. That is the whole feedback loop: change a knob and
 * the run visibly gets shorter against a ruler that does not move. A chart
 * that rescales to fit would hide the only thing worth seeing.
 */
const AXIS_MS = WORST_MS;
const scale = (ms: number) => G_LEFT + (ms / AXIS_MS) * (G_RIGHT - G_LEFT);
const laneY = (host: (typeof MANAGED)[number]) =>
  G_TOP + MANAGED.indexOf(host) * LANE_H;

/**
 * Every configuration, scheduled here rather than in the browser. Shipping
 * the answers costs about thirty kilobytes and keeps one scheduler in the
 * repository instead of two that can disagree — and `tests/ansible-run.test.ts`
 * holds the one.
 */
const key = (o: RunOptions) =>
  `${o.forks}|${o.strategy}|${o.gathering}|${o.pipelining ? 1 : 0}`;

const round = (x: number) => Math.round(x * 100) / 100;

const SCHEDULES = (() => {
  const out: Record<string, { rows: number[][]; end: number }> = {};
  for (const forks of CHOICES.forks) {
    for (const strategy of CHOICES.strategy) {
      for (const gathering of CHOICES.gathering) {
        for (const pipelining of CHOICES.pipelining) {
          const opt = { forks, strategy, gathering, pipelining };
          const { slots, end } = buildSchedule(opt);
          out[key(opt)] = {
            /* event index, then the four moments and the worker; task and
               host come off the event, so they are not sent twice */
            rows: slots.map(x => [
              x.event,
              round(x.t0),
              round(x.out),
              round(x.back),
              round(x.t1),
              x.fork,
            ]),
            end: round(end),
          };
        }
      }
    }
  }
  return out;
})();

/** Each task's window at the default settings, for the rail under the drawing. */
const windows = TASKS.map(task => {
  const mine = SCHEDULE.filter(s => s.task === task.n);
  return {
    n: task.n,
    name: task.name,
    play: task.play,
    handler: task.handler ?? false,
    t0: Math.min(...mine.map(s => s.t0)),
    t1: Math.max(...mine.map(s => s.t1)),
  };
});

/* ── the hook ──────────────────────────────────────────────────────────── */

/**
 * The overview the page used to open without: a run is a GRID. Tasks down,
 * hosts across, and every cell one module built here and run there. The
 * Gantt below is this same grid with a duration in each cell, which is the
 * one sentence that makes the rest of the page legible.
 */
const GRID_W = 1000;
const CELL = 34;
const GRID_LEFT = 232;
const GRID_TOP = 58;
const gridTasks = TASKS;
const GRID_H = GRID_TOP + gridTasks.length * CELL + 16;
const cellX = (host: (typeof MANAGED)[number]) =>
  GRID_LEFT + MANAGED.indexOf(host) * 108;
const cellY = (n: number) =>
  GRID_TOP + gridTasks.findIndex(t => t.n === n) * CELL;

const cells = gridTasks.flatMap(task =>
  MANAGED.map(host => {
    const e = EVENTS.find(x => x.task === task.n && x.host === host);
    return {
      task: task.n,
      host,
      verdict: e?.verdict ?? null,
      /* a host the play does not target has no cell at all */
      absent: !task.hosts.includes(host),
    };
  }),
);

/* ── the ladder ────────────────────────────────────────────────────────── */

/**
 * Eight places one variable could be set, for the ladder to resolve live.
 * Reading twenty-two rungs teaches nobody the rule; losing an argument with
 * the rule teaches everybody.
 */
const SOURCES = [
  {
    rung: 2,
    file: "roles/webserver/defaults/main.yml",
    value: 80,
    scope: "all",
  },
  {
    rung: 6,
    file: "inventory/group_vars/webservers.yml",
    value: 8000,
    scope: "web",
  },
  { rung: 7, file: "group_vars/webservers.yml", value: 8080, scope: "web" },
  { rung: 10, file: "host_vars/web3.yml", value: 8081, scope: "web3" },
  { rung: 12, file: "play vars", value: 8080, scope: "all" },
  {
    rung: 15,
    file: "roles/webserver/vars/main.yml",
    value: 9090,
    scope: "all",
  },
  { rung: 19, file: "set_fact", value: 9999, scope: "all" },
  { rung: 22, file: "-e nginx_port=1234", value: 1234, scope: "all" },
] as const;

/** what the page's own playbook actually does */
const SOURCES_ON = [2, 12];

/* ── one task, to scale ────────────────────────────────────────────────── */

/**
 * The transport drawn rather than counted. Both rows share one scale — the
 * far link, where the difference is worth something — so the shorter row is
 * literally a quarter of the longer one and no caption has to say so.
 */
const T_W = 1000;
const T_H = 300;
const T_LEFT = 152;
const T_RIGHT = 958;
const T_GAP = 74;
const LAT = LINK_MS.db1;
/** eight crossings is the unpipelined task, and it sets the ruler */
const T_SPAN = 8 * LAT;
const tx = (ms: number) => T_LEFT + (ms / T_SPAN) * (T_RIGHT - T_LEFT);

const legsFor = (ops: string[]) =>
  ops.flatMap((op, i) => [
    { op, dir: "down" as const, a: tx(2 * i * LAT), b: tx((2 * i + 1) * LAT) },
    {
      op: "",
      dir: "up" as const,
      a: tx((2 * i + 1) * LAT),
      b: tx((2 * i + 2) * LAT),
    },
  ]);

const TRIPS = [
  {
    mode: "pipelining = False",
    lean: false,
    y: 56,
    ms: 8 * LAT,
    /* Short, because each label has one crossing's width to live in and a
       truncated command reads better than four that overlap. */
    legs: legsFor([
      "mkdir …/tmp/",
      "put AnsiballZ_dnf.py",
      "python3 AnsiballZ_dnf.py",
      "rm -rf …/tmp/",
    ]),
  },
  {
    mode: "pipelining = True",
    lean: true,
    y: 206,
    ms: 2 * LAT,
    legs: legsFor(["python3  ← AnsiballZ_dnf.py on stdin"]),
  },
];

/* ── the five words ────────────────────────────────────────────────────── */

/**
 * The verdicts as the decision that produces them. Two are settled on the
 * control node before anything is sent; the other three are what the module
 * found when it arrived — which is the sentence "a verdict is about the
 * host" drawn instead of asserted.
 */
const F_W = 1000;
const F_H = 300;

const FLOW_NODES = [
  { id: "task", kind: "start", x: 76, y: 112, w: 108, text: "a task", sub: "" },
  {
    id: "when",
    kind: "ask",
    x: 248,
    y: 112,
    w: 128,
    text: "when:",
    sub: "on the control node",
  },
  {
    id: "ssh",
    kind: "ask",
    x: 436,
    y: 112,
    w: 128,
    text: "reachable?",
    sub: "SSH, not the module",
  },
  {
    id: "run",
    kind: "ask",
    x: 648,
    y: 112,
    w: 150,
    text: "module runs",
    sub: "on the managed host",
  },
  { id: "v-ok", kind: "end v-ok", x: 900, y: 44, w: 124, text: "ok", sub: "" },
  {
    id: "v-changed",
    kind: "end v-changed",
    x: 900,
    y: 112,
    w: 124,
    text: "changed",
    sub: "",
  },
  {
    id: "v-failed",
    kind: "end v-failed",
    x: 900,
    y: 180,
    w: 124,
    text: "failed",
    sub: "",
  },
  {
    id: "v-skipped",
    kind: "end v-skipped",
    x: 248,
    y: 256,
    w: 128,
    text: "skipped",
    sub: "",
  },
  {
    id: "v-unreachable",
    kind: "end v-unreachable",
    x: 436,
    y: 256,
    w: 140,
    text: "unreachable",
    sub: "",
  },
];

/**
 * An elbow from one box's right edge to another's left edge. `mid` is
 * explicit because three branches leave the same point: sharing a default
 * midpoint would draw them on top of each other.
 */
const across = (
  ax: number,
  ay: number,
  bx: number,
  by: number,
  mid?: number,
) => (ay === by ? `M${ax} ${ay}H${bx}` : `M${ax} ${ay}H${mid}V${by}H${bx}`);

const down = (x: number, ay: number, by: number) => `M${x} ${ay}V${by}`;

const FLOW_EDGES = [
  {
    to: "when",
    d: across(130, 112, 184, 112),
    label: "",
    lx: 0,
    ly: 0,
    a: "middle",
  },
  {
    to: "ssh",
    d: across(312, 112, 372, 112),
    label: "true",
    lx: 342,
    ly: 103,
    a: "middle",
  },
  {
    to: "v-skipped",
    d: down(248, 127, 241),
    label: "false",
    lx: 256,
    ly: 188,
    a: "start",
  },
  {
    to: "run",
    d: across(500, 112, 573, 112),
    label: "yes",
    lx: 536,
    ly: 103,
    a: "middle",
  },
  {
    to: "v-unreachable",
    d: down(436, 127, 241),
    label: "no",
    lx: 444,
    ly: 188,
    a: "start",
  },
  {
    to: "v-ok",
    d: across(723, 112, 838, 44, 790),
    label: "already so",
    lx: 784,
    ly: 70,
    a: "end",
  },
  {
    to: "v-changed",
    d: across(723, 112, 838, 112),
    label: "acted",
    lx: 780,
    ly: 126,
    a: "middle",
  },
  {
    to: "v-failed",
    d: across(723, 112, 838, 180, 814),
    label: "could not",
    lx: 808,
    ly: 160,
    a: "end",
  },
];

/**
 * The listing, as one string. Astro's own indentation between elements would
 * otherwise land inside the `<pre>` as literal blank lines, so the markup is
 * assembled here with no whitespace between lines at all.
 */
const esc = (t: string) =>
  t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/** Notes are authored with backticks; every one of them is a <code>. */
const ticks = (t: string) => esc(t).replace(/`([^`]+)`/g, "<code>$1</code>");

const yamlHtml = PLAYBOOK.map(
  line =>
    `<span class="ln" data-task="${line.task ?? ""}">` +
    (line.segs.length
      ? line.segs
          .map(seg =>
            seg.k
              ? `<span class="s-${seg.k}">${esc(seg.t)}</span>`
              : esc(seg.t),
          )
          .join("")
      : " ") +
    `</span>`,
).join("");

const payload = {
  hosts: Object.fromEntries(
    HOSTS.map(h => [
      h.id,
      {
        name: h.name,
        fqdn: h.fqdn,
        role: h.role,
        about: h.about,
        groups: h.groups,
        python: h.python,
        facts: h.facts,
        ms: LINK_MS[h.id] ?? null,
        ...fanPos[h.id],
      },
    ]),
  ),
  plays: PLAYS.map(p => ({
    n: p.n,
    name: p.name,
    target: p.target,
    hosts: p.hosts,
    summary: p.summary,
  })),
  tasks: TASKS.map(t => ({
    n: t.n,
    play: t.play,
    name: t.name,
    module: t.module,
    summary: t.summary,
    hosts: t.hosts,
    handler: t.handler ?? false,
  })),
  events: EVENTS.map(e => ({
    task: e.task,
    host: e.host,
    verdict: e.verdict,
    why: e.why,
    module: e.module,
    args: e.args,
    stages: e.stages,
    ret: e.ret,
    notified: e.notified ?? null,
    runMs: e.runMs,
  })),
  schedules: SCHEDULES,
  choices: CHOICES,
  defaults: DEFAULTS,
  axis: AXIS_MS,
  stock: RUN_END - 120,
  target: TARGET_MS,
  best: BEST_MS,
  worst: WORST_MS,
  linkMs: LINK_MS,
  sources: SOURCES,
  sourcesOn: SOURCES_ON,
  managed: MANAGED,
};
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title}>
    <div class="app-prose intro">
      <p>
        A run is a grid: tasks down, hosts across, and every cell one module
        built on your machine and run on theirs.
      </p>
    </div>
  </Main>

  <!-- The overview first, because a reader cannot be shown a barrier before
       they know what is being held back. This is the Gantt below with the
       time taken out of it. -->
  <section class="hook">
    <svg
      class="grid"
      viewBox={`0 0 ${GRID_W} ${GRID_H}`}
      role="img"
      aria-label="A grid of eight tasks against four hosts, one cell per module run"
    >
      <g class="grid-heads" aria-hidden="true">
        {
          MANAGED.map(id => {
            const h = HOSTS.find(x => x.id === id)!;
            return (
              <g>
                <text class="grid-host" x={cellX(id)} y={GRID_TOP - 22}>
                  {h.name}
                </text>
                <text class="grid-os" x={cellX(id)} y={GRID_TOP - 9}>
                  {h.facts[1]?.value}
                </text>
              </g>
            );
          })
        }
      </g>

      <g class="grid-rows">
        {
          gridTasks.map(task => (
            <g class="grid-row" data-task={task.n}>
              <text class="grid-task" x={GRID_LEFT - 44} y={cellY(task.n) + 4}>
                {task.handler ? `${task.name} (handler)` : task.name}
              </text>
              <text class="grid-mod" x={GRID_LEFT - 44} y={cellY(task.n) + 17}>
                {task.module}
              </text>
            </g>
          ))
        }
      </g>

      <g class="grid-cells">
        {
          cells.map(c =>
            c.absent ? (
              <text class="grid-gap" x={cellX(c.host)} y={cellY(c.task) + 4}>
                ·
              </text>
            ) : (
              <g class={`gcell v-${c.verdict}`} data-task={c.task}>
                <rect
                  x={cellX(c.host) - 26}
                  y={cellY(c.task) - 8}
                  width="52"
                  height="16"
                  rx="2"
                />
                <text x={cellX(c.host)} y={cellY(c.task) + 4}>
                  {c.verdict}
                </text>
              </g>
            ),
          )
        }
      </g>
    </svg>

    <p class="hook-note">
      Thirty-two cells, nineteen of them a module. A host the play does not
      target has no cell; <code>web3</code> has one that was decided without opening
      a connection. Give every cell a duration and a worker and the grid becomes a
      schedule — which is the drawing below, and the only thing on this page that
      decides how long a run takes.
    </p>
  </section>

  <!-- Three panes need more than the 64rem reading measure, and §9's rule
       governs copy, which this is not. -->
  <section class="bench">
    <div class="source">
      <p class="label">site.yml</p>
      <pre class="code yaml" id="yaml"><code set:html={yamlHtml} /></pre>

      <p class="label sub">inventory/hosts.ini</p>
      <pre class="code ini"><code>{INVENTORY}</code></pre>

      <!-- Written at runtime: the four knobs below the schedule ARE these
           four lines, and seeing them change is half the point of having
           them. -->
      <p class="label sub">ansible.cfg</p>
      <pre
        class="code ini"
        id="cfg"><code><span>[defaults]</span><span>forks = <b id="cfg-forks">{DEFAULTS.forks}</b></span><span>strategy = <b id="cfg-strategy">{DEFAULTS.strategy}</b></span><span>gathering = <b id="cfg-gathering">{DEFAULTS.gathering}</b></span><span> </span><span>[ssh_connection]</span><span>pipelining = <b id="cfg-pipelining">True</b></span><span>ssh_args = -o ControlMaster=auto -o ControlPersist=60s</span></code></pre>
    </div>

    <div class="stage">
      <svg
        class="fan"
        viewBox={`0 0 ${FAN_W} ${FAN_H}`}
        role="img"
        aria-label="One control node and four managed hosts, joined by SSH"
      >
        <g class="links">
          {
            LINKS.map(l => (
              <g class="chan" data-host={l.host}>
                <line
                  class="hit"
                  x1={fanPos.control.x}
                  y1={fanPos.control.y}
                  x2={fanPos[l.host].x}
                  y2={fanPos[l.host].y}
                />
                <line
                  class="wire"
                  x1={fanPos.control.x}
                  y1={fanPos.control.y}
                  x2={fanPos[l.host].x}
                  y2={fanPos[l.host].y}
                />
                <text
                  class="ms"
                  x={(fanPos.control.x + fanPos[l.host].x) / 2}
                  y={(fanPos.control.y + fanPos[l.host].y) / 2 - 7}
                >
                  {l.ms} ms
                </text>
              </g>
            ))
          }
        </g>

        <g class="nodes">
          {
            HOSTS.map(h => (
              <g
                class="node"
                data-host={h.id}
                transform={`translate(${fanPos[h.id].x} ${fanPos[h.id].y})`}
                tabindex="0"
                role="button"
                aria-label={`${h.name} — ${h.role}`}
              >
                <circle class="hit-dot" r="30" />
                <circle class="halo" r="19" />
                {h.id === "control" ? (
                  <path
                    class="glyph"
                    d="M-13 -9h26v18h-26zM-13 -9l13 9 13 -9M-4 13h8"
                  />
                ) : (
                  <path
                    class="glyph"
                    d="M-12 -11h24v9h-24zM-12 2h24v9h-24zM-8 -7h3M-8 6h3"
                  />
                )}
                {h.id === "control" ? (
                  <Fragment>
                    <text class="name under" y="36">
                      {h.name}
                    </text>
                    <text class="sub under" y="50">
                      ansible-playbook site.yml
                    </text>
                  </Fragment>
                ) : (
                  <Fragment>
                    <text class="name beside" x="38" y="-4">
                      {h.name}
                    </text>
                    <text class="sub beside" x="38" y="10">
                      {h.fqdn}
                    </text>
                    <text class="role beside" x="38" y="25">
                      {h.role}
                    </text>
                  </Fragment>
                )}
              </g>
            ))
          }
        </g>

        <g class="payloads" aria-hidden="true"></g>
      </svg>

      <svg
        class="gantt"
        viewBox={`0 0 ${G_W} ${G_H}`}
        role="img"
        aria-label="The schedule of the run, one lane per host"
      >
        <g class="axis" aria-hidden="true">
          {
            Array.from(
              { length: Math.floor(AXIS_MS / 1000) + 1 },
              (_, i) => i * 1000,
            ).map(ms => {
              return (
                <g>
                  <line
                    class="tick"
                    x1={scale(ms)}
                    y1={G_TOP - 10}
                    x2={scale(ms)}
                    y2={G_H - 14}
                  />
                  <text class="tick-ms" x={scale(ms)} y={G_TOP - 16}>
                    {ms / 1000}s
                  </text>
                </g>
              );
            })
          }
        </g>

        <!-- Where every host must arrive before any host may leave. Drawn
             at runtime, because dropping them is what `strategy: free`
             means and the reader can do that from here. -->
        <g class="barriers" aria-hidden="true"></g>

        <!-- The two marks the run is measured against: where it finishes on
             the settings the page opens with, and where it would have to
             finish to count as fast. Neither moves. -->
        <g class="marks" aria-hidden="true">
          <line
            class="mark stock"
            x1={scale(RUN_END - 120)}
            y1={G_TOP - 6}
            x2={scale(RUN_END - 120)}
            y2={G_H - 16}></line>
          <text class="mark-tag" x={scale(RUN_END - 120) - 6} y={G_H - 2}>
            stock
          </text>
          <line
            class="mark target"
            x1={scale(TARGET_MS)}
            y1={G_TOP - 6}
            x2={scale(TARGET_MS)}
            y2={G_H - 16}></line>
          <text class="mark-tag target" x={scale(TARGET_MS) - 6} y={G_H - 2}>
            {(TARGET_MS / 1000).toFixed(1)}s
          </text>
        </g>

        <g class="lanes">
          {
            MANAGED.map(id => {
              const h = HOSTS.find(x => x.id === id)!;
              return (
                <g class="lane" data-host={id}>
                  <line
                    class="lane-rail"
                    x1={G_LEFT}
                    y1={laneY(id) + LANE_H / 2}
