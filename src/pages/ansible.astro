  }

  /* ── fields ────────────────────────────────────────────────────────── */

  .sidebar :global(.fields) {
    margin-top: 10px;
  }

  .sidebar :global(.fields.split) {
    margin-top: 18px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
  }

  .sidebar :global(.row) {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 2px 12px;
    padding: 5px 0;
  }

  .sidebar :global(.row.lit) {
    background: var(--haze);
  }

  .sidebar :global(.row dt) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-4);
    overflow-wrap: anywhere;
  }

  .sidebar :global(.row dd) {
    margin: 0;
    font-size: 13.5px;
    color: var(--text-2);
