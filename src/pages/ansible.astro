  <!-- Data, not code: is:inline keeps Astro's bundler out of it. -->
  <script
    is:inline
    type="application/json"
    id="run"
    set:html={JSON.stringify(payload)}
  />

  <script>
    type Fact = { key: string; value: string; note?: string };
    type HostInfo = {
      name: string;
      fqdn: string;
      role: string;
      about: string;
      groups: string[];
      python: string;
      facts: Fact[];
      ms: number | null;
      x: number;
      y: number;
    };
    type TaskInfo = {
      n: number;
      play: number;
      name: string;
      module: string;
      summary: string;
      hosts: string[];
      handler: boolean;
    };
    type PlayInfo = {
      n: number;
      name: string;
      target: string;
      hosts: string[];
      summary: string;
    };
    type Arg = { key: string; raw: string; resolved?: string; note?: string };
    type Stage = {
      name: string;
      where: "control" | "wire" | "target";
      summary: string;
      lines: { text: string; note?: string }[];
    };
    type EventInfo = {
      task: number;
      host: string;
      verdict: "ok" | "changed" | "skipped" | "failed";
      why: string;
      module: string;
      args: Arg[];
      stages: Stage[];
      ret: { key: string; value: string; note?: string }[];
      notified: string | null;
      runMs: number;
    };
    type Slot = {
      event: number;
      task: number;
      host: string;
      t0: number;
      out: number;
      back: number;
      t1: number;
      fork: number;
    };
    type Options = {
      forks: number;
      strategy: string;
      gathering: string;
      pipelining: boolean;
    };
    /** [event, t0, out, back, t1, fork] — task and host come off the event */
    type Row = [number, number, number, number, number, number];
    type Source = {
      rung: number;
      file: string;
      value: number;
      scope: string;
    };
    type Run = {
      hosts: Record<string, HostInfo>;
      plays: PlayInfo[];
      tasks: TaskInfo[];
      events: EventInfo[];
      schedules: Record<string, { rows: Row[]; end: number }>;
      choices: {
        forks: number[];
        strategy: string[];
        gathering: string[];
        pipelining: boolean[];
      };
      defaults: Options;
      axis: number;
      stock: number;
      target: number;
      best: number;
      worst: number;
      linkMs: Record<string, number>;
      sources: Source[];
      sourcesOn: number[];
      managed: string[];
    };

    /**
     * What the right-hand pane is showing. `auto` follows the run; everything
     * else is pinned by a click, and a pin survives the clock moving on —
     * reaching for a value means you want to read it.
     */
    type Selection =
      | { kind: "auto" }
      | { kind: "slot"; slot: number }
      | { kind: "host"; host: string }
      | { kind: "task"; task: number };

    const start = () => {
      const data = document.getElementById("run");
      const fan = document.querySelector<SVGSVGElement>(".fan");
      const gantt = document.querySelector<SVGSVGElement>(".gantt");
      if (!data || !fan || !gantt) return;

      const run: Run = JSON.parse(data.textContent ?? "{}");
      const { hosts, tasks, events } = run;

      const taskOf = (n: number) => tasks.find(t => t.n === n)!;
      const eventOf = (slot: Slot) => events[slot.event];

      /* ── the configuration, and the schedule it picks ───────────────── */

      /**
       * Every schedule was built on the server and shipped. Switching one
       * is a lookup, so a knob answers instantly — and there is still only
       * one scheduler in the repository, which is the one the tests hold.
       */
      const options: Options = { ...run.defaults };

      const keyOf = (o: Options) =>
        `${o.forks}|${o.strategy}|${o.gathering}|${o.pipelining ? 1 : 0}`;

      const expand = (rows: Row[]): Slot[] =>
        rows.map(([event, t0, out, back, t1, fork]) => ({
          event,
          task: events[event].task,
          host: events[event].host,
          t0,
          out,
          back,
          t1,
          fork,
        }));

      let schedule: Slot[] = expand(run.schedules[keyOf(options)].rows);
      /** where the run itself ends, with a beat after it for the recap */
      let end = run.schedules[keyOf(options)].end + 120;

      /* ── state ──────────────────────────────────────────────────────── */

      const payloads = fan.querySelector<SVGGElement>(".payloads")!;
      const playhead = gantt.querySelector<SVGLineElement>(".playhead")!;
      const scrub = document.getElementById("scrub") as HTMLInputElement;
      const playBtn = document.getElementById("play") as HTMLButtonElement;
      const clockOut = document.getElementById("clock-s")!;
      const kindOut = document.getElementById("side-kind")!;
      const bodyOut = document.getElementById("side-body")!;
      const railEl = document.getElementById("rail")!;
      const recapEl = document.getElementById("recap")!;
      const yamlEl = document.getElementById("yaml")!;

      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      let t = 0;
      let playing = false;
      let speed = 1;
      let raf = 0;
      let lastFrame = 0;
      let selection: Selection = { kind: "auto" };
      let pinnedByPointer = false;
      /** which stage of the event's exchange the panel is opened at */
      let pickedStage = 0;
      /** the hovered argument or line, held as state so a rebuild keeps it */
      let litLine: string | null = null;
      let lastKey = "";

      /* The Gantt's own geometry, read back off a lane rail — which never
         moves — so there is one source for it rather than two that drift. */
      const laneRail = gantt.querySelector<SVGLineElement>(".lane-rail")!;
      const G_LEFT = Number(laneRail.getAttribute("x1"));
      const G_RIGHT = Number(laneRail.getAttribute("x2"));
      const LANE_H = 44;
      const G_TOP = 34;
      const G_H = G_TOP + run.managed.length * LANE_H + 14;

      /* The ruler is the SLOWEST configuration, not the one on screen, so a
         faster run is visibly shorter rather than merely relabelled. */
      const scale = (ms: number) =>
        G_LEFT + (ms / run.axis) * (G_RIGHT - G_LEFT);
      const unscale = (x: number) =>
        ((x - G_LEFT) / (G_RIGHT - G_LEFT)) * run.axis;
      const laneY = (host: string) =>
        G_TOP + run.managed.indexOf(host) * LANE_H + LANE_H / 2;

      /* ── what is happening at time t ────────────────────────────────── */

      /** on the wire, in one direction or the other */
      const flying = (now: number) =>
        schedule.filter(
          s =>
            s.fork >= 0 &&
            ((now >= s.t0 && now < s.out) || (now > s.back && now <= s.t1)),
        );

      /** the module is running on the target */
      const working = (now: number) =>
        schedule.filter(s => s.fork >= 0 && now >= s.out && now <= s.back);

      const landed = (now: number) => schedule.filter(s => now >= s.t1);

      /** the task the run is in, which is the last one to have started */
      const taskAt = (now: number) => {
        let n = -1;
        for (const s of schedule) if (s.t0 <= now) n = Math.max(n, s.task);
        return n;
      };

      /** the slot the panel follows when nothing is pinned */
      const current = (now: number) => {
        const live = [...flying(now), ...working(now)];
        if (live.length) {
          return schedule.indexOf(live.reduce((a, b) => (b.t0 > a.t0 ? b : a)));
        }
        const done = landed(now);
        if (!done.length) return -1;
        return schedule.indexOf(done.reduce((a, b) => (b.t1 > a.t1 ? b : a)));
      };

      /* ── the star ───────────────────────────────────────────────────── */

      const drawPayloads = (now: number) => {
        const live = flying(now);
        const keep = new Set<string>();
        const control = hosts.control;

        for (const slot of live) {
          const id = `p${schedule.indexOf(slot)}`;
          keep.add(id);
          const host = hosts[slot.host];
          const outbound = now < slot.out;
          const span = outbound ? slot.out - slot.t0 : slot.t1 - slot.back;
          const k = span
            ? (outbound ? now - slot.t0 : now - slot.back) / span
            : 1;
          const p = outbound ? k : 1 - k;
          const x = control.x + (host.x - control.x) * p;
          const y = control.y + (host.y - control.y) * p;

          let g = payloads.querySelector<SVGGElement>(`[data-p="${id}"]`);
          if (!g) {
            g = document.createElementNS("http://www.w3.org/2000/svg", "g");
            g.setAttribute("data-p", id);
            g.innerHTML =
              `<circle class="dot" r="5"></circle>` +
              `<text class="tag" y="-12"></text>`;
            payloads.appendChild(g);
          }
          g.setAttribute("transform", `translate(${x} ${y})`);
          g.classList.toggle("back", !outbound);
          const tag = g.querySelector("text")!;
          tag.textContent = outbound
            ? `AnsiballZ_${eventOf(slot).module.split(".").pop()}`
            : "JSON";
        }

        for (const g of [...payloads.children]) {
          if (!keep.has(g.getAttribute("data-p") ?? "")) g.remove();
        }

        /* a channel is live while anything of its host's is in the air */
        const onWire = new Set(live.map(s => s.host));
        const onTarget = new Set(working(now).map(s => s.host));
        for (const ch of fan.querySelectorAll<SVGGElement>(".chan")) {
          const host = ch.dataset.host ?? "";
          ch.classList.toggle("live", onWire.has(host));
        }
        for (const node of fan.querySelectorAll<SVGGElement>(".node")) {
          const host = node.dataset.host ?? "";
          node.classList.toggle("busy", onTarget.has(host) || onWire.has(host));
        }
      };

      /* ── the Gantt ──────────────────────────────────────────────────── */

      const SVGNS = "http://www.w3.org/2000/svg";
      const barsEl = gantt.querySelector<SVGGElement>(".bars")!;
      const barriersEl = gantt.querySelector<SVGGElement>(".barriers")!;

      const svgEl = <K extends keyof SVGElementTagNameMap>(
        tag: K,
        attrs: Record<string, string | number>,
        cls?: string,
      ) => {
        const el = document.createElementNS(SVGNS, tag);
        if (cls) el.setAttribute("class", cls);
        for (const [k, v] of Object.entries(attrs)) {
          el.setAttribute(k, String(v));
        }
        return el;
      };

      /**
       * The Gantt is redrawn from scratch whenever the configuration moves,
       * because every bar's place in it changed. It is nineteen bars, so
       * rebuilding costs nothing and a diffing pass would only be a second
       * thing to get wrong.
       */
      const buildGantt = () => {
        barsEl.textContent = "";
        barriersEl.textContent = "";

        /* A barrier is a wall every host must reach before any may leave,
           so it exists only under the linear strategy. */
        if (options.strategy === "linear") {
          const walls = [
            ...new Set(
              tasks
                .slice(0, -1)
                .map(task =>
                  Math.max(
                    ...schedule.filter(s => s.task === task.n).map(s => s.t1),
                  ),
                )
                .filter(ms => ms > 0 && ms < end - 120),
            ),
          ];
          for (const ms of walls) {
            barriersEl.appendChild(
              svgEl(
                "line",
                {
                  x1: scale(ms),
                  y1: G_TOP - 6,
                  x2: scale(ms),
                  y2: G_H - 16,
                },
                "barrier",
              ),
            );
          }
        }

        schedule.forEach((s, i) => {
          const e = eventOf(s);
          const y = laneY(s.host);
          const x0 = scale(s.t0);
          const x1 = scale(s.t1);
          const g = svgEl("g", {}, `bar v-${e.verdict}`);
          g.dataset.slot = String(i);
          g.dataset.task = String(s.task);
          g.dataset.host = s.host;
          g.setAttribute("tabindex", "0");
          g.setAttribute("role", "button");
          g.setAttribute(
            "aria-label",
            `${taskOf(s.task).name} on ${s.host} — ${e.verdict}`,
          );

          g.appendChild(
            svgEl(
              "rect",
              {
                x: x0 - 4,
                y: y - 15,
                width: Math.max(8, x1 - x0 + 8),
                height: 30,
              },
              "bar-hit",
            ),
          );
          /* the two crossings of the channel, drawn as the thin ends */
          g.appendChild(
            svgEl("line", { x1: x0, y1: y, x2: scale(s.out), y2: y }, "leg"),
          );
          g.appendChild(
            svgEl("line", { x1: scale(s.back), y1: y, x2: x1, y2: y }, "leg"),
          );
          g.appendChild(
            svgEl(
              "rect",
              {
                x: scale(s.out),
                y: y - 7,
                width: Math.max(2, scale(s.back) - scale(s.out)),
                height: 14,
                rx: 2,
              },
              "body",
            ),
          );
          const tag = svgEl("text", { x: x0 + 3, y: y - 12 }, "bar-tag");
          tag.textContent = String(s.task);
          g.appendChild(tag);
          barsEl.appendChild(g);
        });
      };

      const paintGantt = (now: number) => {
        playhead.setAttribute("x1", String(scale(now)));
        playhead.setAttribute("x2", String(scale(now)));

        const picked = selection.kind === "slot" ? selection.slot : -1;
        const auto = current(now);

        for (const bar of gantt.querySelectorAll<SVGGElement>(".bar")) {
          const i = Number(bar.dataset.slot);
          const s = schedule[i];
          bar.classList.toggle("done", now >= s.t1);
          bar.classList.toggle("live", now >= s.t0 && now < s.t1);
          bar.classList.toggle("ahead", now < s.t0);
          bar.classList.toggle(
            "picked",
            i === picked || (picked < 0 && i === auto),
          );
        }
      };

      /* ── the rail, the listing and the recap ────────────────────────── */

      /** the rail carries each task's start, which moves with the knobs */
      const buildRail = () => {
        for (const li of railEl.querySelectorAll<HTMLLIElement>("li")) {
          const n = Number(li.dataset.task);
          const mine = schedule.filter(s => s.task === n);
          if (!mine.length) continue;
          const t0 = Math.min(...mine.map(s => s.t0));
          li.dataset.t0 = String(t0);
          const span = li.querySelector("span");
          if (span) {
            span.textContent =
              `${(t0 / 1000).toFixed(2)}s` +
              (taskOf(n).handler ? " · handler" : "");
          }
        }
      };

      const paintRail = (now: number) => {
        const at = taskAt(now);
        for (const li of railEl.querySelectorAll<HTMLLIElement>("li")) {
          const n = Number(li.dataset.task);
          li.classList.toggle("on", n === at);
          li.classList.toggle("done", n < at);
        }
      };

      /** the task the listing is lighting, so it is only scrolled on a change */
      let litTask = -2;

      const paintYaml = (now: number) => {
        const at =
          selection.kind === "task"
            ? selection.task
            : selection.kind === "slot"
              ? schedule[selection.slot].task
              : taskAt(now);
        let first: HTMLElement | null = null;
        for (const ln of yamlEl.querySelectorAll<HTMLElement>(".ln")) {
          const n = ln.dataset.task;
          const on = n !== "" && Number(n) === at;
          ln.classList.toggle("on", on);
          if (on && !first) first = ln;
        }

        /* The pane scrolls itself rather than the page: `scrollIntoView`
           would drag the whole document every time a task begins. */
        if (at !== litTask) {
          litTask = at;
          if (first) {
            const want =
              first.offsetTop - yamlEl.clientHeight / 2 + first.offsetHeight;
            yamlEl.scrollTo({
              top: Math.max(0, want),
              behavior: reduced ? "auto" : "smooth",
            });
          }
        }
      };

      const paintRecap = (now: number) => {
        const done = landed(now);
        for (const tr of recapEl.querySelectorAll<HTMLTableRowElement>(
          "tbody tr",
        )) {
          const host = tr.dataset.host ?? "";
          const mine = done.filter(s => s.host === host).map(eventOf);
          const n = (v: string) => mine.filter(e => e.verdict === v).length;
          const cell = (col: string, value: number) => {
            const td = tr.querySelector<HTMLElement>(`[data-col="${col}"]`)!;
            td.textContent = String(value);
            td.classList.toggle("some", value > 0);
          };
          cell("ok", n("ok") + n("changed"));
          cell("changed", n("changed"));
          cell("unreachable", 0);
          cell("failed", n("failed"));
          cell("skipped", n("skipped"));
          tr.classList.toggle("full", mine.length > 0);
        }
      };

      /* ── the sidebar ────────────────────────────────────────────────── */

      const esc = (s: string) =>
        s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      const mono = (s: string) =>
        esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");

      const row = (key: string, value: string, note?: string, id?: string) =>
        `<div class="row${id && id === litLine ? " lit" : ""}"${
          id ? ` data-line="${id}"` : ""
        }><dt>${esc(key)}</dt><dd>${value}${
          note ? `<em>${mono(note)}</em>` : ""
        }</dd></div>`;

      const argRows = (args: Arg[]) =>
        args
          .map((a, i) =>
            row(
              a.key,
              a.resolved
                ? `<code class="raw">${esc(a.raw)}</code>` +
                    `<span class="arrow"> &rarr; </span>` +
                    `<code class="res">${esc(a.resolved)}</code>`
                : `<code>${esc(a.raw)}</code>`,
              a.note,
              `a${i}`,
            ),
          )
          .join("");

      const stageStrip = (stages: Stage[]) =>
        `<div class="strip">` +
        stages
          .map(
            (s, i) =>
              `<span class="seg w-${s.where}${i === pickedStage ? " lit" : ""}" ` +
              `data-stage="${i}" role="button" tabindex="0">` +
              `<span class="seg-name">${esc(s.name)}</span>` +
              `<span class="seg-where">${s.where}</span></span>`,
          )
          .join("") +
        `</div>`;

      const stageBody = (stage: Stage) =>
        `<div class="stage-head w-${stage.where}">` +
        `<span class="stage-name">${esc(stage.name)}</span>` +
        `<span class="stage-where">${
          stage.where === "control"
            ? "on the control node"
            : stage.where === "wire"
              ? "over SSH"
              : "on the managed host"
        }</span>` +
        `<span class="stage-summary">${mono(stage.summary)}</span>` +
        `</div>` +
        `<div class="lines">` +
        stage.lines
          .map(
            (l, i) =>
              `<div class="line${litLine === `l${i}` ? " lit" : ""}" ` +
              `data-line="l${i}"><code>${esc(l.text)}</code>${
                l.note ? `<em>${mono(l.note)}</em>` : ""
              }</div>`,
          )
          .join("") +
        `</div>`;

      /**
       * A fact gathering served from the cache did not happen. Showing its
       * stages would be drawing a conversation that never took place, so it
       * gets a panel of its own — and that panel is where the knob's real
       * effect belongs anyway.
       */
      const cachedPanel = (i: number) => {
        const s = schedule[i];
        const host = hosts[s.host];
        kindOut.textContent = `CACHED FACTS · ${host.name}`;
        return (
          `<p class="side-task"><b>Gathering Facts</b>` +
          `<span>ansible.builtin.setup — not run</span></p>` +
          `<p class="side-lead">Nothing happened on this host. With ` +
          `<code>gathering = cached</code> the control node reads the facts a ` +
          `previous run wrote to disk, so the largest module in Ansible is ` +
          `never built, never sent and never executed.</p>` +
          `<p class="swap">It still costs nothing in correctness: task 3's ` +
          `<code>when</code> reads <code>os_family</code>, and the cache has ` +
          `it. Turning gathering <em>off</em> would not — that is the ` +
          `difference between the two fixes.</p>` +
          `<p class="label sub">What the cache held</p>` +
          `<div class="fields">` +
          host.facts
            .map(f =>
              row(
                f.key.replace("ansible_facts.", ""),
                `<code>${esc(f.value)}</code>`,
                f.note,
              ),
            )
            .join("") +
          `</div>` +
          `<div class="fields split">` +
          row("cost", "0 ms", "no worker, no connection, no module") +
          row(
            "what it saved",
            `${eventOf(s).runMs} ms`,
            "on this host alone; multiply by every host and every play",
          ) +
          `</div>`
        );
      };

      const slotPanel = (i: number) => {
        const s = schedule[i];
        const e = eventOf(s);
        const task = taskOf(s.task);
        const host = hosts[s.host];
        if (s.fork < 0 && e.verdict !== "skipped") return cachedPanel(i);
        const stage = e.stages[Math.min(pickedStage, e.stages.length - 1)];

        kindOut.textContent = task.handler
          ? `RUNNING HANDLER · ${host.name}`
          : `TASK ${s.task} · ${host.name}`;

        return (
          `<p class="side-task"><b>${esc(task.name)}</b>` +
          `<span>${esc(task.module)}</span></p>` +
          `<p class="side-lead">${mono(task.summary)}</p>` +
          `<p class="verdict v-${e.verdict}">` +
          `<span class="chip">${e.verdict}</span>` +
          `<span class="why">${mono(e.why)}</span></p>` +
          (e.module !== task.module
            ? `<p class="swap">Resolved to <code>${esc(e.module)}</code> on ` +
              `this host — not the module the YAML names.</p>`
            : "") +
          (e.notified
            ? `<p class="swap">Notified <code>${esc(e.notified)}</code>, which ` +
              `will not run until the play is over.</p>`
            : "") +
          `<p class="label sub">Arguments <span class="size">as resolved</span></p>` +
          `<div class="fields">${argRows(e.args)}</div>` +
          `<p class="label sub">The exchange <span class="size">` +
          `${(s.t1 - s.t0).toFixed(0)} ms${
            s.fork >= 0 ? ` · fork ${s.fork}` : " · no fork"
          }</span></p>` +
          stageStrip(e.stages) +
          stageBody(stage) +
          `<p class="label sub">Returned</p>` +
          `<div class="fields">` +
          e.ret
            .map(r => row(r.key, `<code>${esc(r.value)}</code>`, r.note))
            .join("") +
          `</div>` +
          `<div class="fields split">` +
          row("started", `${(s.t0 / 1000).toFixed(2)}s`) +
          row(
            "on the wire",
            `${(2 * (host.ms ?? 0)).toFixed(1)} ms`,
            "two crossings, because pipelining makes it one operation",
          ) +
          row("in the module", `${e.runMs} ms`) +
          `</div>`
        );
      };

      const hostPanel = (id: string) => {
        const h = hosts[id];
        kindOut.textContent = id === "control" ? "CONTROL NODE" : "HOST";
        const mine = schedule.filter(s => s.host === id);
        const counts = (v: string) =>
          mine.filter(s => eventOf(s).verdict === v).length;

        return (
          `<p class="side-task"><b>${esc(h.name)}</b>` +
          `<span>${esc(h.fqdn)}</span></p>` +
          `<p class="side-lead">${mono(h.about)}</p>` +
          (id === "control"
            ? `<div class="fields">` +
              row("python", `<code>${esc(h.python)}</code>`) +
              row(
                "installed here only",
                `<code>ansible-core</code>`,
                "the managed hosts need SSH and a Python, and nothing else",
              ) +
              `</div>`
            : `<div class="fields">` +
              row("groups", h.groups.map(g => `<code>${g}</code>`).join(" ")) +
              row(
                "interpreter",
                `<code>${esc(h.python)}</code>`,
                "discovered, then every module is piped into it",
              ) +
              row(
                "link",
                `${h.ms} ms`,
                "each way, on a connection ControlPersist keeps open",
              ) +
              row(
                "this run",
                `${counts("ok") + counts("changed")} ok · ` +
                  `${counts("changed")} changed · ${counts("skipped")} skipped`,
              ) +
              `</div>` +
              `<p class="label sub">Facts that decided something</p>` +
              `<div class="fields">` +
              h.facts
                .map(f =>
                  row(
                    f.key.replace("ansible_facts.", ""),
                    `<code>${esc(f.value)}</code>`,
                    f.note,
                  ),
                )
                .join("") +
              `</div>`)
        );
      };

      const taskPanel = (n: number) => {
        const task = taskOf(n);
        const play = run.plays.find(p => p.n === task.play)!;
        kindOut.textContent = task.handler ? "HANDLER" : `TASK ${n}`;
        const mine = schedule.filter(s => s.task === n);

        return (
          `<p class="side-task"><b>${esc(task.name)}</b>` +
          `<span>${esc(task.module)}</span></p>` +
          `<p class="side-lead">${mono(task.summary)}</p>` +
          `<p class="swap">In play ${play.n + 1}, <b>${esc(play.name)}</b> ` +
          `&mdash; <code>hosts: ${esc(play.target)}</code></p>` +
          `<p class="label sub">Per host</p>` +
          `<div class="fields">` +
          mine
            .map(s => {
              const e = eventOf(s);
              return row(
                hosts[s.host].name,
                `<span class="chip v-${e.verdict}">${e.verdict}</span>`,
                e.why,
              );
            })
            .join("") +
          `</div>` +
          `<p class="side-note">Click a bar on the schedule for what went over ` +
          `the wire.</p>`
        );
      };

      /** where this configuration's time actually went */
      const spentNow = () => {
        const real = schedule.filter(s => s.fork >= 0);
        const sum = (list: Slot[], f: (s: Slot) => number) =>
          list.reduce((acc, s) => acc + f(s), 0);
        return {
          module: sum(real, s => eventOf(s).runMs),
          wire: sum(real, s => s.out - s.t0 + (s.t1 - s.back)),
          facts: sum(
            real.filter(s => eventOf(s).module.endsWith("setup")),
            s => eventOf(s).runMs,
          ),
          installs: sum(
            real.filter(s => s.task === 1),
            s => eventOf(s).runMs,
          ),
          wall: end - 120,
        };
      };

      const endPanel = () => {
        kindOut.textContent = "PLAY RECAP";
        const spent = spentNow();
        const pct = (x: number) => `${((x / spent.wall) * 100).toFixed(0)}%`;
        const beat = spent.wall < run.target;
        const stock = run.stock;
        const delta = stock - spent.wall;

        return (
          `<p class="side-lead">The run finished in ` +
          `<b>${(spent.wall / 1000).toFixed(2)} s</b>` +
          (Math.abs(delta) < 1
            ? ", on the settings the page opens with."
            : delta > 0
              ? ` — ${(delta / 1000).toFixed(2)} s faster than the ` +
                `settings the page opens with.`
              : ` — ${(-delta / 1000).toFixed(2)} s slower than the ` +
                `settings the page opens with.`) +
          `</p>` +
          (beat
            ? `<p class="swap">Under ${(run.target / 1000).toFixed(1)} s. ` +
              `Nothing in the playbook changed: the whole difference is four ` +
              `lines of <code>ansible.cfg</code>.</p>`
            : `<p class="swap">Still over ` +
              `${(run.target / 1000).toFixed(1)} s. The fastest this run can ` +
              `be made to go is ${(run.best / 1000).toFixed(2)} s, and the ` +
              `knobs above are the only things that get it there.</p>`) +
          `<div class="fields">` +
          row(
            "inside modules",
            `${(spent.module / 1000).toFixed(2)} s`,
            spent.module > spent.wall
              ? "more than the wall clock, because the forks overlap"
              : "and nothing overlapped, because there was one fork",
          ) +
          row(
            "the two installs",
            `${(spent.installs / 1000).toFixed(2)} s`,
            `${pct(spent.installs)} of the run, in one task — and the one ` +
              `number on this page no setting can move`,
          ) +
          row(
            "gathering facts",
            `${(spent.facts / 1000).toFixed(2)} s`,
            spent.facts > 0
              ? "four hosts, ~1,200 facts each, and this play reads six"
              : "served from the cache: no host was contacted for them",
          ) +
          row(
            "on the wire",
            `${spent.wire.toFixed(0)} ms`,
            `every crossing of every link, added up — ` +
              `${options.pipelining ? "one" : "four"} round trip` +
              `${options.pipelining ? "" : "s"} a task`,
          ) +
          `</div>` +
          `<p class="side-note">The playbook was never edited. A run's ` +
          `length is decided by how many hosts are worked at once, whether ` +
          `they wait for each other, and how often facts are fetched — none ` +
          `of which is in the YAML.</p>`
        );
      };

      const paintSidebar = (now: number) => {
        /* Declared without a value: the chain below is exhaustive, so an
           initialiser here would only ever be thrown away. */
        let key: string;
        let html: string;

        if (selection.kind === "slot") {
          key = `s${selection.slot}:${pickedStage}:${litLine}`;
          html = slotPanel(selection.slot);
        } else if (selection.kind === "host") {
          key = `h${selection.host}:${litLine}`;
          html = hostPanel(selection.host);
        } else if (selection.kind === "task") {
          key = `t${selection.task}:${litLine}`;
          html = taskPanel(selection.task);
        } else if (now >= end - 120) {
          key = "end";
          html = endPanel();
        } else {
          const i = current(now);
          if (i < 0) {
            key = "pre";
            kindOut.textContent = "Following the run";
            html =
              `<p class="side-empty">Press play. The first thing any play ` +
              `does is gather facts, whether or not anything reads them.</p>`;
          } else {
            key = `s${i}:${pickedStage}:${litLine}`;
            html = slotPanel(i);
          }
        }

        if (key === lastKey) return;
        lastKey = key;
        bodyOut.innerHTML = html;
      };

      /* ── the loop ───────────────────────────────────────────────────── */

      const render = () => {
        drawPayloads(t);
        paintGantt(t);
        paintRail(t);
        paintYaml(t);
        paintRecap(t);
        paintSidebar(t);
        clockOut.textContent = (t / 1000).toFixed(2);
        scrub.value = String(Math.round((t / end) * 1000));
      };

      const frame = (now: number) => {
        if (!playing) return;
        const dt = Math.min(64, now - lastFrame);
        lastFrame = now;
        t += dt * speed;
        if (t >= end) {
          t = end;
          setPlaying(false);
          render();
          return;
        }
        render();
        raf = requestAnimationFrame(frame);
      };

      function setPlaying(on: boolean) {
        playing = on && !reduced;
        playBtn.textContent = playing ? "Pause" : "Play";
        playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
        if (playing) {
          lastFrame = performance.now();
          raf = requestAnimationFrame(frame);
        } else {
          cancelAnimationFrame(raf);
        }
      }

      const select = (s: Selection) => {
        selection = s;
        pinnedByPointer = false;
        pickedStage = 0;
        lastKey = "";
        render();
      };

      /* ── what a reader can do ───────────────────────────────────────── */

      /* ── the four knobs ─────────────────────────────────────────────── */

      const cfgOut = {
        forks: document.getElementById("cfg-forks")!,
        strategy: document.getElementById("cfg-strategy")!,
        gathering: document.getElementById("cfg-gathering")!,
        pipelining: document.getElementById("cfg-pipelining")!,
      };
      const scoreMs = document.getElementById("score-ms")!;
      const scoreNote = document.getElementById("score-note")!;

      /**
       * A knob changes four things at once: the schedule drawn, the config
       * file beside it, the score, and where the clock is allowed to go.
       * The clock is kept where it was rather than reset, so a reader
       * watching one moment can change a setting and watch the same moment.
       */
      const reconfigure = () => {
        const picked = run.schedules[keyOf(options)];
        schedule = expand(picked.rows);
        end = picked.end + 120;
        t = Math.min(t, end);

        cfgOut.forks.textContent = String(options.forks);
        cfgOut.strategy.textContent = options.strategy;
        cfgOut.gathering.textContent = options.gathering;
        cfgOut.pipelining.textContent = options.pipelining ? "True" : "False";

        const wall = picked.end;
        scoreMs.textContent = `${(wall / 1000).toFixed(2)}s`;
        const over = wall - run.target;
        scoreNote.textContent =
          over <= 0
            ? `under ${(run.target / 1000).toFixed(1)}s`
            : `${(over / 1000).toFixed(2)}s over`;
        scoreMs.classList.toggle("won", over <= 0);
        scoreNote.classList.toggle("won", over <= 0);

        /* a pinned slot may not exist in the same place in the new schedule */
        if (selection.kind === "slot" && selection.slot >= schedule.length) {
          selection = { kind: "auto" };
        }

        buildGantt();
        buildRail();
        lastKey = "";
        render();
      };

      for (const b of document.querySelectorAll<HTMLButtonElement>(
        "[data-knob]",
      )) {
        b.addEventListener("click", () => {
          const knob = b.dataset.knob!;
          const raw = b.dataset.value!;
          if (knob === "forks") options.forks = Number(raw);
          else if (knob === "pipelining") options.pipelining = raw === "1";
          else if (knob === "strategy") options.strategy = raw;
          else if (knob === "gathering") options.gathering = raw;

          for (const o of document.querySelectorAll<HTMLButtonElement>(
            `[data-knob="${knob}"]`,
          )) {
            const on = o === b;
            o.classList.toggle("on", on);
            o.setAttribute("aria-pressed", on ? "true" : "false");
          }
          reconfigure();
        });
      }

      playBtn.addEventListener("click", () => {
        if (!playing && t >= end) t = 0;
        setPlaying(!playing);
      });

      scrub.addEventListener("input", () => {
        t = (Number(scrub.value) / 1000) * end;
        lastKey = "";
        render();
      });

      for (const b of document.querySelectorAll<HTMLButtonElement>(
        "[data-speed]",
      )) {
        b.addEventListener("click", () => {
          speed = Number(b.dataset.speed);
          for (const o of document.querySelectorAll("[data-speed]")) {
            o.classList.toggle("on", o === b);
          }
        });
      }

      /* a bar is the event; a lane name is the host */
      const pickFromGantt = (target: EventTarget | null) => {
        const el = target as Element | null;
        const bar = el?.closest<SVGGElement>(".bar");
        if (bar) {
          select({ kind: "slot", slot: Number(bar.dataset.slot) });
          return true;
        }
        const lane = el?.closest<SVGGElement>(".lane");
        if (lane?.dataset.host) {
          select({ kind: "host", host: lane.dataset.host });
          return true;
        }
        return false;
      };

      gantt.addEventListener("click", e => {
        if (pickFromGantt(e.target)) return;
        /* empty track: scrub to that moment instead */
        const box = gantt.getBoundingClientRect();
        const x =
          ((e.clientX - box.left) / box.width) * gantt.viewBox.baseVal.width;
        const ms = unscale(x);
        if (ms >= 0 && ms <= end) {
          t = ms;
          select({ kind: "auto" });
        }
      });

      gantt.addEventListener("keydown", e => {
        if (e.key === "Enter" || e.key === " ") {
          if (pickFromGantt(e.target)) e.preventDefault();
        }
      });

      fan.addEventListener("click", e => {
        const el = e.target as Element;
        const node = el.closest<SVGGElement>(".node");
        if (node?.dataset.host) {
          select({ kind: "host", host: node.dataset.host });
          return;
        }
        const chan = el.closest<SVGGElement>(".chan");
        if (chan?.dataset.host)
          select({ kind: "host", host: chan.dataset.host });
      });

      fan.addEventListener("keydown", e => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const node = (e.target as Element).closest<SVGGElement>(".node");
        if (node?.dataset.host) {
          e.preventDefault();
          select({ kind: "host", host: node.dataset.host });
        }
      });

      /* a line of YAML selects its task; the rail jumps the clock to it */
      yamlEl.addEventListener("click", e => {
        const ln = (e.target as Element).closest<HTMLElement>(".ln");
        const n = ln?.dataset.task;
        if (n) select({ kind: "task", task: Number(n) });
      });

      railEl.addEventListener("click", e => {
        const li = (e.target as Element).closest<HTMLLIElement>("li");
        if (!li) return;
        t = Number(li.dataset.t0);
        select({ kind: "auto" });
      });

      /**
       * Reaching into the panel pins it. A panel that moves to the next event
       * mid-read is useless, so the pointer arriving holds what is on screen
       * and the pointer leaving hands it back.
       */
      bodyOut.addEventListener("pointerenter", () => {
        if (selection.kind !== "auto") return;
        const i = current(t);
        if (i < 0) return;
        selection = { kind: "slot", slot: i };
        pinnedByPointer = true;
        lastKey = "";
        render();
      });

      bodyOut.addEventListener("pointerleave", () => {
        litLine = null;
        if (!pinnedByPointer) {
          lastKey = "";
          render();
          return;
        }
        pinnedByPointer = false;
        selection = { kind: "auto" };
        lastKey = "";
        render();
      });

      bodyOut.addEventListener("pointerover", e => {
        const el = (e.target as Element).closest<HTMLElement>("[data-line]");
        const id = el?.dataset.line ?? null;
        if (id === litLine) return;
        litLine = id;
        for (const n of bodyOut.querySelectorAll("[data-line]")) {
          n.classList.toggle("lit", (n as HTMLElement).dataset.line === id);
        }
      });

      bodyOut.addEventListener("click", e => {
        const seg = (e.target as Element).closest<HTMLElement>("[data-stage]");
        if (!seg) return;
        pickedStage = Number(seg.dataset.stage);
        lastKey = "";
        render();
      });

      const keys = (e: KeyboardEvent) => {
        const tag = (e.target as HTMLElement)?.tagName;
        if (tag === "INPUT" || tag === "TEXTAREA") return;
        if (e.key === " ") {
          e.preventDefault();
          if (!playing && t >= end) t = 0;
          setPlaying(!playing);
        } else if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          e.preventDefault();
          setPlaying(false);
          t = Math.max(
            0,
            Math.min(end, t + (e.key === "ArrowRight" ? 120 : -120)),
          );
          lastKey = "";
          render();
        } else if (e.key === "Escape") {
          select({ kind: "auto" });
        }
      };

      document.addEventListener("keydown", keys);
      document.addEventListener("astro:before-swap", () => {
        cancelAnimationFrame(raf);
        document.removeEventListener("keydown", keys);
      });

      /* ── the ladder, which is also a model ──────────────────────────── */

      /**
       * Twenty-two rungs is reference; losing an argument with them is the
       * lesson. Toggling a source lights its rung and says which value
       * survives — including the case the list cannot show, where a host
       * disagrees with its own group.
       */
      const sourcesEl = document.getElementById("sources");
      const resolvedEl = document.getElementById("resolved");
      const ladderEl = document.getElementById("ladder");

      if (sourcesEl && resolvedEl && ladderEl) {
        const resolve = () => {
          const on = [
            ...sourcesEl.querySelectorAll<HTMLButtonElement>("button.on"),
          ].map(b => ({
            rung: Number(b.dataset.rung),
            value: Number(b.dataset.value),
            scope: b.dataset.scope!,
          }));

          for (const li of ladderEl.querySelectorAll<HTMLLIElement>("li")) {
            const rung = Number(li.dataset.rung);
            li.classList.toggle(
              "set",
              on.some(o => o.rung === rung),
            );
            li.classList.remove("wins");
          }

          if (!on.length) {
            resolvedEl.innerHTML =
              `<span class="undef">nginx_port is undefined</span> — and a ` +
              `template that reads it fails the task, on every host.`;
            return;
          }

          /** the winner for a host is the highest rung that reaches it */
          const winner = (scopes: string[]) =>
            on
              .filter(o => scopes.includes(o.scope))
              .reduce((a, b) => (b.rung > a.rung ? b : a));

          const web = winner(["all", "web"]);
          const web3 = winner(["all", "web", "web3"]);
          const split = web3.rung !== web.rung;

          for (const li of ladderEl.querySelectorAll<HTMLLIElement>("li")) {
            const rung = Number(li.dataset.rung);
            if (rung === web.rung || (split && rung === web3.rung)) {
              li.classList.add("wins");
            }
          }

          const fileOf = (rung: number) =>
            run.sources.find(x => x.rung === rung)!.file;

          resolvedEl.innerHTML =
            `<span class="won-line"><b>nginx_port = ${web.value}</b> ` +
            `<span>rung ${web.rung} · <code>${esc(fileOf(web.rung))}</code>` +
            `</span></span>` +
            (split
              ? `<span class="won-line split"><b>on web3: ` +
                `${web3.value}</b> <span>rung ${web3.rung} · ` +
                `<code>${esc(fileOf(web3.rung))}</code> — host beats group` +
                `</span></span>`
              : "");
        };

        sourcesEl.addEventListener("click", e => {
          const b = (e.target as Element).closest<HTMLButtonElement>("button");
          if (!b) return;
          const on = !b.classList.contains("on");
          b.classList.toggle("on", on);
          b.setAttribute("aria-pressed", on ? "true" : "false");
          resolve();
        });

        resolve();
      }

      buildGantt();
      buildRail();
      render();
      if (!reduced) setPlaying(true);
    };

    start();
    document.addEventListener("astro:after-swap", start);
  </script>
</Layout>

<style>
  .intro {
    margin-bottom: clamp(26px, 4vh, 40px);
  }

  /* ── the hook ──────────────────────────────────────────────────────── */

  .hook {
    width: 100%;
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: clamp(22px, 6vw, 40px);
    padding-bottom: clamp(26px, 4vh, 44px);
  }

  .grid {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid-host {
    font-family: var(--font-display);
    font-size: 13.5px;
    fill: var(--text-3);
    text-anchor: middle;
  }

  .grid-os {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--text-4);
    text-anchor: middle;
  }

  .grid-task {
    font-family: var(--font-display);
    font-size: 13px;
    fill: var(--text-3);
    text-anchor: end;
  }

  .grid-mod {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--text-4);
    text-anchor: end;
  }

  /* A cell says what it did, and nothing says it louder than it should:
     `changed` is the only one carrying full ink, because it is the only one
     that altered a host. */
  .gcell rect {
    fill: none;
    stroke: var(--border-recess);
    stroke-width: 1;
  }

  .gcell text {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--text-4);
    text-anchor: middle;
  }

  .gcell.v-changed rect {
    fill: var(--panel);
    stroke: var(--text-4);
  }

  .gcell.v-changed text {
    fill: var(--text-2);
  }

  .gcell.v-skipped rect {
    stroke-dasharray: 2 2;
  }

  .grid-gap {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--border-recess);
    text-anchor: middle;
  }

  .hook-note {
    margin: 18px 0 0;
    max-width: 68ch;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-4);
  }

  /* ── the bench ─────────────────────────────────────────────────────── */

  /* Source, execution, detail. Three panes is the arrangement of a
     debugger, borrowed because it is the right mental model for a run. */
  .bench {
    display: grid;
    grid-template-columns:
      minmax(0, 0.66fr) minmax(0, 1.6fr)
      minmax(260px, 0.88fr);
    gap: clamp(18px, 2.2vw, 34px);
    width: 100%;
    max-width: 104rem;
    margin-inline: auto;
    padding-inline: clamp(22px, 5vw, 40px);
    padding-bottom: clamp(30px, 6vh, 60px);
  }

  /* ── the source pane ───────────────────────────────────────────────── */

  .source {
    min-width: 0;
    align-self: start;
    position: sticky;
    top: 16px;
  }

  .code {
    margin: 10px 0 0;
    padding: 12px 14px;
    background: var(--panel);
    border-inline-start: 1px solid var(--border-recess);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.65;
    overflow-x: auto;
    color: var(--syn-plain);
    white-space: pre;
  }

  /* A sticky source pane that is taller than the screen is no use, so it
     scrolls on its own and the running task is brought into it. */
  .yaml {
    max-height: 64vh;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* Written with set:html, so every selector below has to be global. */
  .yaml :global(.ln) {
    display: block;
    margin-inline: -14px;
    padding-inline: 14px;
    cursor: pointer;
  }

  .yaml :global(.ln[data-task=""]) {
    cursor: default;
  }

  .yaml :global(.ln:not([data-task=""]):hover) {
    background: var(--haze);
  }

  /* The running task lights its own source. One hairline, inside the
     recess, because §9 draws no box. */
  .yaml :global(.ln.on) {
    background: var(--arcane-tint);
    box-shadow: inset 2px 0 0 var(--arcane);
  }

  .yaml :global(.s-key) {
    color: var(--syn-keyword);
  }

  .yaml :global(.s-name),
  .yaml :global(.s-str) {
    color: var(--syn-string);
  }

  .yaml :global(.s-num) {
    color: var(--syn-constant);
  }

  .yaml :global(.s-jinja) {
    color: var(--arcane);
  }

  .yaml :global(.s-comment) {
    color: var(--syn-comment);
  }

  .ini {
    color: var(--syn-plain);
  }

  /* ── the star ──────────────────────────────────────────────────────── */

  .fan,
  .gantt {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .wire {
    stroke: var(--border);
    stroke-width: 1;
  }

  .chan.live .wire {
    stroke: var(--text-4);
    stroke-width: 1.4;
  }

  /* A hairline cannot be clicked, so every channel carries a fat
     transparent twin. */
  .hit {
    stroke: transparent;
    stroke-width: 18;
    cursor: pointer;
  }

  .ms {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--text-4);
    text-anchor: middle;
  }

  .glyph {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .halo {
    fill: var(--ground);
  }

  .hit-dot {
    fill: transparent;
    cursor: pointer;
  }

  .node .name {
    font-family: var(--font-display);
    font-size: 14px;
    fill: var(--text-3);
  }

  .node .sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--text-4);
  }

  /* Four hosts stacked in a column cannot carry centred captions: they
     collide with each other and with the schedule's axis below. */
  .node .under {
    text-anchor: middle;
  }

  .node .beside {
    text-anchor: start;
  }

  .node.busy .glyph,
  .node:hover .glyph {
    stroke: var(--text);
  }

  .node.busy .name {
    fill: var(--text-2);
  }

  .node:focus-visible {
    outline: none;
  }

  .node:focus-visible .glyph {
    stroke: var(--torch);
  }

  .node .role {
    font-size: 12px;
    fill: var(--text-4);
  }

  /* NOT gold. The dots were gilded until the fork knob existed, and then
     five of them could be in the air at once — §4 allows three marks in a
     viewport, so the page spends its gold on the score instead, where it
     means the one thing that is actually rare. */
  .payloads :global(.dot) {
    fill: var(--text-2);
  }

  .payloads :global(.back .dot) {
    fill: var(--arcane);
  }

  .payloads :global(.tag) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--text-3);
    text-anchor: middle;
  }

  /* ── the schedule ──────────────────────────────────────────────────── */

  .tick {
    stroke: var(--border);
    stroke-width: 1;
    stroke-dasharray: 1 7;
  }

  .tick-ms {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--text-4);
    text-anchor: middle;
  }

  /* The bars and the barriers are built at runtime — a scoped selector
     never matches DOM that did not exist at build time — so everything the
     script draws is reached through :global. */
  .gantt :global(.barrier) {
    stroke: var(--text-4);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.75;
  }

  .lane-rail {
    stroke: var(--border-recess);
    stroke-width: 1;
  }

  .lane-name {
    font-family: var(--font-display);
    font-size: 13px;
    fill: var(--text-3);
    text-anchor: end;
    cursor: pointer;
  }

  .lane-os {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--text-4);
    text-anchor: end;
    cursor: pointer;
  }

  .lane:hover .lane-name {
    fill: var(--text);
  }

  .gantt :global(.bar-hit) {
    fill: transparent;
    cursor: pointer;
  }

  /* A bar is thin at the ends — the two crossings of the channel — and
     thick in the middle, where the module is actually running. */
  .gantt :global(.leg) {
    stroke: var(--text-4);
    stroke-width: 1;
  }

  .gantt :global(.bar .body) {
    fill: var(--text-4);
    stroke: none;
  }

  /* ok did nothing, so it is drawn as nothing: an outline. */
  .gantt :global(.bar.v-ok .body) {
    fill: none;
    stroke: var(--text-4);
    stroke-width: 1;
  }

  .gantt :global(.bar.v-changed .body) {
    fill: var(--text-2);
  }

  .gantt :global(.bar.v-skipped .body) {
    fill: none;
    stroke: var(--border-recess);
    stroke-dasharray: 2 2;
  }

  .gantt :global(.bar.v-failed .body) {
    fill: var(--blood);
  }

  /* Ahead of the playhead the whole schedule is visible but unlit: a
     reader cannot see a barrier they have to remember. */
  .gantt :global(.bar.ahead) {
    opacity: 0.42;
  }

  .gantt :global(.bar.live .body) {
    fill: var(--text);
  }

  .gantt :global(.bar.live.v-ok .body) {
    stroke: var(--text-2);
  }

  .gantt :global(.bar.picked .body) {
    stroke: var(--arcane);
    stroke-width: 1.6;
  }

  .gantt :global(.bar.picked .leg) {
    stroke: var(--arcane);
  }

  .gantt :global(.bar-tag) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--text-4);
    opacity: 0;
  }

  .gantt :global(.bar:hover .bar-tag),
  .gantt :global(.bar.picked .bar-tag),
  .gantt :global(.bar.live .bar-tag) {
    opacity: 1;
  }

  .gantt :global(.bar:focus-visible) {
    outline: none;
  }

  .gantt :global(.bar:focus-visible .body) {
    stroke: var(--torch);
    stroke-width: 1.6;
  }

  .playhead {
    stroke: var(--ornament);
    stroke-width: 1;
  }

  /* ── transport ─────────────────────────────────────────────────────── */

  .transport {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .transport button {
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--text-3);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--border);
    padding: 2px 2px 4px;
    cursor: pointer;
  }

  .transport button:hover,
  .transport button.on {
    color: var(--text);
    border-bottom-color: var(--text-4);
  }

  .speeds {
    display: flex;
    gap: 8px;
  }

  #scrub {
    flex: 1;
    accent-color: var(--text-3);
    cursor: pointer;
  }

  .clock {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-4);
    font-variant-numeric: tabular-nums;
    min-width: 7ch;
    text-align: end;
  }

  .map-hint {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-4);
  }

  /* ── the task rail ─────────────────────────────────────────────────── */

  .bench .rail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(104px, 1fr));
    gap: 0 12px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .bench .rail :global(li) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 0 0;
    border-top: 1px solid var(--border);
    cursor: pointer;
    color: var(--text-4);
    min-width: 0;
  }

  .bench .rail :global(li b) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 12.5px;
    line-height: 1.25;
    color: var(--text-4);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bench .rail :global(li span) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .bench .rail :global(li.done b) {
    color: var(--text-3);
  }

  .bench .rail :global(li.on) {
    border-top-color: var(--text-3);
  }

  .bench .rail :global(li.on b) {
    color: var(--text);
  }

  .bench .rail :global(li:hover b) {
    color: var(--text-2);
  }

  /* ── the recap ─────────────────────────────────────────────────────── */

  .recap {
    width: 100%;
    margin-top: 10px;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
  }

  .recap th {
    text-align: end;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-4);
    border-bottom: 1px solid var(--border);
    padding: 0 0 6px 10px;
  }

  .recap th:first-child,
  .recap td:first-child {
    text-align: start;
    padding-inline-start: 0;
  }

  .recap td {
    text-align: end;
    padding: 5px 0 5px 10px;
    color: var(--text-4);
    border-bottom: 1px solid var(--border-recess);
  }

  .recap tr.full td:first-child {
    color: var(--text-2);
  }

  .recap td.some {
    color: var(--text-2);
  }

  /* ── the sidebar ───────────────────────────────────────────────────── */

  .sidebar {
    border-inline-start: 1px solid var(--border);
    padding-inline-start: clamp(14px, 1.6vw, 24px);
    min-width: 0;
  }

  .sidebar :global(.side-task) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 12px 0 0;
  }

  .sidebar :global(.side-task b) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 17px;
    color: var(--text);
  }

  .sidebar :global(.side-task span) {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-4);
  }

  .sidebar :global(.side-lead) {
    margin: 10px 0 0;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  .sidebar :global(.side-empty),
  .sidebar :global(.side-note) {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-4);
  }

  .sidebar :global(.swap) {
    margin: 12px 0 0;
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-3);
  }

  .sidebar :global(.verdict) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 14px 0 0;
  }

  .sidebar :global(.verdict .why) {
    font-size: 13.5px;
    line-height: 1.6;
    font-style: italic;
    color: var(--text-3);
  }

  /* ── verdict chips, used in both panes ─────────────────────────────── */

  :global(.chip) {
    display: inline-block;
    align-self: start;
    justify-self: start;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-4);
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
  }

  :global(.v-changed .chip),
  :global(.chip.v-changed) {
    color: var(--text);
    border-bottom-color: var(--text-3);
  }

  :global(.v-ok .chip),
  :global(.chip.v-ok) {
    color: var(--text-3);
  }

  :global(.v-skipped .chip),
  :global(.chip.v-skipped) {
    color: var(--text-4);
    border-bottom-style: dashed;
  }

  :global(.v-failed .chip),
  :global(.chip.v-failed),
  :global(.v-unreachable .chip) {
    color: var(--blood);
    border-bottom-color: var(--blood);
  }

  .sidebar :global(.label.sub) {
    margin-top: 20px;
  }

  .sidebar :global(.size) {
    margin-inline-start: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-4);
  }

  /* ── the stage strip ───────────────────────────────────────────────── */

  .sidebar :global(.strip) {
    display: flex;
    gap: 2px;
    margin-top: 10px;
  }

  .sidebar :global(.seg) {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    padding: 6px;
    background: var(--panel);
    border-top: 1px solid var(--border);
    overflow: hidden;
    cursor: pointer;
  }

  .sidebar :global(.seg.lit) {
    border-top-color: var(--arcane);
  }

  .sidebar :global(.seg-name) {
    font-family: var(--font-display);
    font-size: 12px;
    white-space: nowrap;
    color: var(--text-3);
  }

  .sidebar :global(.seg.lit .seg-name) {
    color: var(--arcane);
  }

  .sidebar :global(.seg-where) {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    color: var(--text-4);
  }

  /* Where the work happens is the distinction the YAML hides, so it is
     drawn: a stage on the wire is marked, the others are not. */
  .sidebar :global(.seg.w-wire) {
    border-top-style: dashed;
  }

  .sidebar :global(.stage-head) {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: "name where" "summary summary";
    gap: 2px 8px;
    margin-top: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .sidebar :global(.stage-name) {
    grid-area: name;
    font-family: var(--font-display);
    color: var(--text-2);
  }

  .sidebar :global(.stage-where) {
    grid-area: where;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-4);
  }

  .sidebar :global(.stage-head.w-wire .stage-where) {
    color: var(--arcane);
  }

  .sidebar :global(.stage-summary) {
    grid-area: summary;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-4);
  }

  .sidebar :global(.lines) {
    margin-top: 10px;
    padding: 10px 12px;
    background: var(--panel);
    border-inline-start: 1px solid var(--border-recess);
  }

  .sidebar :global(.line) {
    padding: 3px 0;
  }

  .sidebar :global(.line code) {
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  .sidebar :global(.line.lit code) {
    color: var(--text);
  }

  .sidebar :global(.line em) {
    display: block;
    margin-top: 2px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-4);
  }

  /* ── fields ────────────────────────────────────────────────────────── */

  .sidebar :global(.fields) {
    margin-top: 10px;
  }

  .sidebar :global(.fields.split) {
    margin-top: 18px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
  }

  .sidebar :global(.row) {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: 2px 12px;
    padding: 5px 0;
  }

  .sidebar :global(.row.lit) {
    background: var(--haze);
  }

  .sidebar :global(.row dt) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-4);
    overflow-wrap: anywhere;
  }

  .sidebar :global(.row dd) {
    margin: 0;
    font-size: 13.5px;
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .sidebar :global(.row dd code) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
  }

  /* Raw on the left, resolved on the right: the one picture of what Jinja
     actually does, and where it does it. */
  .sidebar :global(.row dd .raw) {
    color: var(--arcane);
  }

  .sidebar :global(.row dd .arrow) {
    color: var(--text-4);
  }

  .sidebar :global(.row dd em) {
    display: block;
    margin-top: 3px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-4);
  }

  /* ── the reference panels ──────────────────────────────────────────── */

  .panels {
    display: grid;
    gap: clamp(40px, 7vh, 76px);
    width: 100%;
    max-width: 74rem;
    margin-inline: auto;
    padding-inline: clamp(22px, 6vw, 40px);
    padding-block: clamp(30px, 6vh, 56px) clamp(40px, 8vh, 80px);
    border-top: 1px solid var(--border);
  }

  .panel {
    margin: 0;
  }

  .panel figcaption {
    max-width: 58ch;
  }

  .panel figcaption p:not(.label) {
    margin: 8px 0 0;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-2);
  }

  .panel .aside {
    margin: 18px 0 0;
    max-width: 62ch;
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--border);
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-4);
  }

  .panel code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--text-3);
  }

  /* ── one task, to scale ───────────────────────────────────────────── */

  .trips {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 26px;
    overflow: visible;
  }

  .party {
    stroke: var(--border);
    stroke-width: 1;
  }

  .party-name {
    font-family: var(--font-display);
    font-size: 12.5px;
    fill: var(--text-4);
    text-anchor: end;
  }

  .trip-mode {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text-3);
  }

  .trip-count {
    font-family: var(--font-display);
    font-size: 13px;
    fill: var(--text-4);
    text-anchor: end;
  }

  .trip.lean .trip-count {
    fill: var(--text-2);
  }

  .leg line {
    stroke: var(--text-4);
    stroke-width: 1;
  }

  /* Outbound carries something; the reply is only an acknowledgement. */
  .leg.up line {
    stroke: var(--border-recess);
    stroke-dasharray: 3 3;
  }

  .trip.lean .leg.down line {
    stroke: var(--text-2);
    stroke-width: 1.4;
  }

  .leg-op {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-4);
  }

  .trip.lean .leg-op {
    fill: var(--text-3);
  }

  /* the ladder */
  .ladder {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    columns: 2;
    column-gap: clamp(22px, 4vw, 48px);
  }

  .ladder li {
    display: grid;
    grid-template-columns: 2.4ch 1fr;
    grid-template-areas: "rung what" ". note";
    gap: 1px 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--border-recess);
    break-inside: avoid;
  }

  .ladder .rung {
    grid-area: rung;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-4);
    text-align: end;
    padding-top: 2px;
  }

  .ladder .what {
    grid-area: what;
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-3);
  }

  .ladder li em {
    grid-area: note;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-4);
  }

  .ladder li.seen .what {
    color: var(--text-2);
  }

  .ladder li.seen .rung {
    color: var(--arcane);
  }

  .ladder li.top {
    border-bottom-color: var(--text-4);
  }

  .ladder li.top .what {
    color: var(--text);
  }

  /* inventory and roles */
  .trees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: clamp(18px, 3vw, 40px);
    margin-top: 22px;
  }

  .tree-head {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--text-3);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .tree-foot {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-4);
  }

  .trees ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .groups li {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    grid-template-areas: "name members" ". note";
    gap: 1px 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border-recess);
  }

  .groups li code {
    grid-area: name;
    font-size: 12.5px;
    color: var(--text-2);
  }

  .groups li span {
    grid-area: members;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-3);
  }

  .groups li em,
  .role-tree li em {
    grid-area: note;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-4);
  }

  .role-tree li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: "path note";
    gap: 2px 10px;
    padding: 6px 0;
    border-bottom: 1px solid var(--border-recess);
  }

  .role-tree li code {
    grid-area: path;
    font-size: 12px;
    color: var(--text-3);
  }

  .role-tree li em {
    grid-area: note;
    text-align: end;
  }

  .role-tree li.root code {
    color: var(--text-2);
  }

  .role-tree li.in code {
    padding-inline-start: 14px;
  }

  /* the five words */
  .verdicts {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
  }

  .verdicts li {
    display: grid;
    grid-template-columns: 11ch minmax(0, 1fr);
    grid-template-areas: "chip what" ". from";
    gap: 3px 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-recess);
  }

  .verdicts .chip {
    grid-area: chip;
  }

  .verdicts li b {
    grid-area: what;
    font-weight: 400;
    font-size: 14.5px;
    color: var(--text-2);
  }

  .verdicts li em {
    grid-area: from;
    font-size: 13px;
    line-height: 1.55;
    color: var(--text-4);
  }

  .check {
    margin-top: 26px;
  }

  .check ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .check li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 2px 14px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border-recess);
  }

  .check li code {
    font-size: 12.5px;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }

  .check li em {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-4);
  }

  /* ── the four knobs ────────────────────────────────────────────────── */

  .knobs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px clamp(14px, 2vw, 26px);
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .knob {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .seg {
    display: flex;
    gap: 1px;
  }

  .seg button {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-4);
    background: var(--panel);
    border: 0;
    border-top: 1px solid var(--border);
    padding: 5px 9px;
    cursor: pointer;
  }

  .seg button:hover {
    color: var(--text-2);
  }

  .seg button.on {
    color: var(--text);
    border-top-color: var(--arcane);
  }

  .score {
    margin: 0 0 0 auto;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .score b {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 19px;
    font-variant-numeric: tabular-nums;
    color: var(--text-2);
  }

  .score span {
    font-family: var(--font-display);
    font-size: 12.5px;
    color: var(--text-4);
  }

  /* The one moment on the page worth gilding: the run got under the mark. */
  .score b.won {
    color: var(--torch);
  }

  .score span.won {
    color: var(--text-2);
  }

  /* the two fixed marks the run is measured against */
  .mark {
    stroke-width: 1;
  }

  .mark.stock {
    stroke: var(--border-recess);
  }

  .mark.target {
    stroke: var(--text-4);
    stroke-dasharray: 1 4;
  }

  .mark-tag {
    font-family: var(--font-display);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    fill: var(--border-recess);
    text-anchor: end;
  }

  .mark-tag.target {
    fill: var(--text-4);
  }

  /* the config file, written at runtime */
  #cfg span {
    display: block;
  }

  #cfg b {
    font-weight: 400;
    color: var(--arcane);
  }

  /* ── the resolver ──────────────────────────────────────────────────── */

  .resolver {
    margin-top: 22px;
  }

  .sources {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1px clamp(14px, 2vw, 28px);
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
  }

  .sources button {
    display: grid;
    grid-template-columns: 2.6ch minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 10px;
    width: 100%;
    padding: 7px 8px;
    background: none;
    border: 0;
    border-top: 1px solid var(--border-recess);
    text-align: start;
    cursor: pointer;
  }

  .sources button:hover .src-file {
    color: var(--text-2);
  }

  .sources button.on {
    background: var(--panel);
    border-top-color: var(--arcane);
  }

  .src-rung {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-4);
    text-align: end;
  }

  .src-file {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-4);
    overflow-wrap: anywhere;
  }

  .sources button.on .src-file,
  .sources button.on .src-rung {
    color: var(--text-3);
  }

  .src-value {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--border-recess);
  }

  .sources button.on .src-value {
    color: var(--arcane);
  }

  .verdict-line {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .verdict-line :global(.won-line) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
  }

  .verdict-line :global(b) {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 15px;
    color: var(--text);
  }

  .verdict-line :global(.split b) {
    font-size: 13.5px;
    color: var(--text-3);
  }

  .verdict-line :global(span span),
  .verdict-line :global(.won-line > span) {
    font-size: 13px;
    color: var(--text-4);
  }

  .verdict-line :global(.undef) {
    color: var(--blood);
  }

  /* A rung that is set is visible; the one that won is the only one lit. */
  .ladder li.set .rung {
    color: var(--arcane);
  }

  .ladder li.set .what {
    color: var(--text-2);
  }

  .ladder li.wins {
    background: var(--panel);
    border-bottom-color: var(--text-4);
  }

  .ladder li.wins .what {
    color: var(--text);
  }

  .ladder li.wins .rung {
    color: var(--text);
  }

  /* ── the five words ────────────────────────────────────────────────── */

  .flow {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 26px;
    overflow: visible;
  }

  .edge path {
    fill: none;
    stroke: var(--border-recess);
    stroke-width: 1;
  }

  .edge-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--text-4);
  }

  .fnode rect {
    fill: var(--ground);
    stroke: var(--border);
    stroke-width: 1;
  }

  .fnode text {
    font-family: var(--font-display);
    font-size: 13px;
    fill: var(--text-3);
    text-anchor: middle;
  }

  .fnode-sub {
    font-family: var(--font-mono);
    font-size: 9.5px;
    fill: var(--text-4);
  }

  .fnode.ask rect {
    stroke: var(--text-4);
  }

  .fnode.ask text {
    fill: var(--text-2);
  }

  .fnode.start rect {
    stroke-dasharray: 3 3;
  }

  /* A terminal is drawn the way its bar is drawn on the schedule above, so
     the two pictures are of the same thing. */
  .fnode.end rect {
    fill: none;
  }

  .fnode.v-changed rect {
    fill: var(--panel);
    stroke: var(--text-2);
  }

  .fnode.v-changed text {
    fill: var(--text);
  }

  .fnode.v-skipped rect {
    stroke-dasharray: 2 2;
  }

  .fnode.v-failed rect,
  .fnode.v-unreachable rect {
    stroke: var(--blood);
  }

  .fnode.v-failed text,
  .fnode.v-unreachable text {
    fill: var(--blood);
  }

  /* A tree with no lines in it is a list. */
  .role-tree {
    position: relative;
  }

  .role-tree li.in {
    position: relative;
  }

  .role-tree li.in code {
    padding-inline-start: 22px;
  }

  .role-tree li.in::before {
    content: "";
    position: absolute;
    inset-inline-start: 5px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border-recess);
  }

  .role-tree li.in.last::before {
    bottom: 50%;
  }

  .role-tree li.in::after {
    content: "";
    position: absolute;
    inset-inline-start: 5px;
    top: 50%;
    width: 9px;
    height: 1px;
    background: var(--border-recess);
  }

  /* ── narrower ──────────────────────────────────────────────────────── */

  /* The detail pane goes under the run before the source does: a reader
     scrubbing the schedule needs the YAML in view more than the hex. */
  @media (max-width: 86rem) {
    .bench {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    }

    .sidebar {
      grid-column: 1 / -1;
      border-inline-start: 0;
      border-top: 1px solid var(--border);
      padding-inline-start: 0;
      padding-top: 16px;
    }
  }

  @media (max-width: 62rem) {
    .bench {
      grid-template-columns: minmax(0, 1fr);
    }

    .source {
      position: static;
      order: 2;
    }

    .sidebar {
      order: 3;
    }

    /* Four lanes and a seven-second axis do not fit in a phone, and
       shrinking them is how a diagram becomes decoration. */
    .stage {
      order: 1;
      overflow-x: auto;
      overscroll-behavior-x: contain;
    }

    .fan,
    .gantt {
      min-width: 620px;
    }

    .transport,
    .map-hint,
