                  <text class="lane-name" x={G_LEFT - 12} y={laneY(id) + 18}>
                    {h.name}
                  </text>
                  <text class="lane-os" x={G_LEFT - 12} y={laneY(id) + 32}>
                    {h.facts[0]?.value} {h.facts[3]?.value}
                  </text>
