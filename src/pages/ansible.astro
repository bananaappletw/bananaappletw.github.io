    line-height: 1.6;
  }

  .sidebar :global(.side-empty),
  .sidebar :global(.side-note) {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-4);
  }

  .sidebar :global(.swap) {
    margin: 12px 0 0;
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-3);
  }

  .sidebar :global(.verdict) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 14px 0 0;
  }

  .sidebar :global(.verdict .why) {
    font-size: 13.5px;
    line-height: 1.6;
    font-style: italic;
    color: var(--text-3);
  }

  /* ── verdict chips, used in both panes ─────────────────────────────── */

  :global(.chip) {
    display: inline-block;
    align-self: start;
    justify-self: start;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-4);
    border-bottom: 1px solid var(--border);
