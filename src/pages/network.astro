---
/**
 * /network — one HTTPS request, simulated.
 *
 * The first version of this page was a slideshow: one frame at a time, a
 * scrubber over a list of hops. It taught the encapsulation and it got the
 * most important thing wrong, which is that a network is a CONTINUOUS
 * system — so this one runs a clock.
 *
 * ── what the simulation is ───────────────────────────────────────────────
 *
 * Every cable has a length in milliseconds (`LINK_MS`) and every device a
 * moment in which it thinks (`THINK_MS`), both in `network-flow.ts`. From
 * those the page builds a SCHEDULE: for each packet and each cable it
 * crosses, a departure and an arrival, with causality carried by a cursor —
 * a hop cannot leave before the hop before it has landed and the device it
 * landed on has finished with it.
 *
 * Drawing is then a pure function of one number. Every packet in flight is
 * a lerp between two devices at time `t`; every table on the page is a fold
 * over the hops that have already landed by `t`. That is what lets the
 * scrubber work on a running simulation: dragging it rewinds nothing, it
 * asks for a different `t`.
 *
 * ── the rhythm is the lesson ─────────────────────────────────────────────
 *
 * Two hops across the house cost less than a fifth of a millisecond; one hop
 * to the server costs nineteen. Watch it run and the shape of a page load is
 * obvious: nearly all of it is distance and the queue at the far end, and
 * almost none of it is the machinery this page draws.
 *
 * ── the other devices ────────────────────────────────────────────────────
 *
 * A phone and a printer hang off the same switch. The printer never speaks,
 * so the switch never learns which port it is on — and the sidebar says so.
 * The phone keeps a connection of its own alive, so the NAT table has a row
 * that has nothing to do with the laptop. One public address, several
 * machines, told apart by a port number: that is a sentence everyone has
 * read, and this is the picture of it.
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import {
  NODES,
  LINKS,
  TICKS,
  STEPS,
  LINK_MS,
  THINK_MS,
  type NodeId,
} from "@/data/network-flow";

const title = "The network";
const description =
  "A live simulation of one HTTPS request: packets crossing a house and the internet in real proportion, with every frame, header and byte open to inspection.";

const W = 1000;
const H = 500;
const at = (n: { x: number; y: number }) => ({ x: n.x * W, y: n.y * H });
const pos = Object.fromEntries(NODES.map(n => [n.id, at(n)]));
const portOf = Object.fromEntries(NODES.map(n => [n.id, n.port ?? null]));

/** the MAC a frame was sent FROM, which is the only thing a switch learns */
const sourceMac = (tickIndex: number) =>
  TICKS[tickIndex].hop.frame.blocks[0].fields[1].value.split(" · ")[0];

const portOfTick = (i: number, side: "src") => {
  const l4 = TICKS[i].hop.frame.blocks.find(
    b => b.name === "TCP" || b.name === "UDP",
  );
  return side === "src" ? (l4?.fields[0].value ?? "—") : "—";
};

/**
 * What each hop teaches the devices it touches, worked out here rather than
 * in the browser: the client should hold a schedule and a fold, and nothing
 * should be parsing a frame sixty times a second.
 */
const effects = TICKS.map(({ hop, step }, i) => {
  const ip = hop.frame.blocks.find(b => b.name === "IPv4");
  const l4 = hop.frame.blocks.find(b => b.name === "TCP" || b.name === "UDP");

  return {
    /** a switch learns a source address on the port it arrived by */
    switchLearn:
      hop.to === "switch" && portOf[hop.from]
        ? { mac: sourceMac(i), port: portOf[hop.from]!, who: hop.from }
        : null,

    /** each end of an ARP exchange comes away with one new row */
    arpLearn:
      step.id === "arp-reply" && hop.to === "laptop"
        ? {
            on: "laptop" as NodeId,
            ip: "192.168.1.1",
            mac: sourceMac(i),
            who: "router" as NodeId,
          }
        : step.id === "arp-request" && hop.to === "router"
          ? {
              on: "router" as NodeId,
              ip: "192.168.1.42",
              mac: sourceMac(i),
              who: "laptop" as NodeId,
            }
          : null,

    /** the NAT row is written the moment a packet leaves for the street */
    nat:
      hop.link === "wan" && hop.from === "router" && ip && l4
        ? {
            proto: l4.name,
            inside: `192.168.1.42:${portOfTick(Math.max(0, i - 1), "src")}`,
            outside: `${ip.fields[8].value}:${l4.fields[0].value}`,
            why: step.label,
          }
        : null,
  };
});

const payload = {
  nodes: Object.fromEntries(
    NODES.map(n => [
      n.id,
      {
        name: n.name,
        role: n.role,
        reads: n.reads,
        about: n.about,
        ifaces: n.ifaces,
        ...pos[n.id],
      },
    ]),
  ),
  links: LINKS.map(l => ({
    id: l.id,
    from: l.from,
    to: l.to,
    medium: l.medium,
    mtu: l.mtu,
    idle: l.idle ?? false,
    ms: LINK_MS[l.id],
  })),
  think: THINK_MS,
  steps: STEPS.map(s => ({ id: s.id, label: s.label, summary: s.summary })),
  ticks: TICKS.map(({ step, hop, stepIndex, hopIndex }, i) => ({
    step: stepIndex,
    hop: hopIndex,
    label: step.label,
    link: hop.link,
    from: hop.from,
    to: hop.to,
    ms: LINK_MS[hop.link],
    changed: hop.frame.changed ?? null,
    effects: effects[i],
    blocks: hop.frame.blocks.map(b => ({
      osi: b.osi,
      name: b.name,
      summary: b.summary,
      offWire: b.offWire ?? false,
      fields: b.fields.map(f => ({
        name: f.name,
        value: f.value,
        note: f.note ?? null,
        hex: f.bytes.map(x => x.toString(16).padStart(2, "0")).join(""),
      })),
    })),
  })),
};
---

<Layout title={`${title} | ${config.site.title}`} description={description}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={title}>
    <div class="app-prose intro">
      <p>
        One request for <code>https://example.com/</code>, running. Every cable
        has a length in milliseconds. Every device takes a moment to think. So
        the timings here are the real ones: two hops across the house cost less
        than a fifth of a millisecond, and one hop to the server costs nineteen.
      </p>
      <p>
        Click anything — a device, a cable, a packet in flight — and the panel
        beside the map says what it is and what it is doing. The tables fill in
        as the simulation runs, because that is how the devices learn too.
      </p>
    </div>
  </Main>

  <!-- The bench breaks the hall. A map with a panel beside it needs more than
       64rem, and §9's rule governs the reading measure, which this is not. -->
  <section class="bench">
    <div class="map-wrap">
      <svg
        class="map"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label="A live map of one HTTPS request crossing eight devices"
      >
        <g class="house" aria-hidden="true">
          <rect x="18" y="26" width="352" height="340" rx="10"></rect>
          <text class="house-label" x="34" y="52">
            192.168.1.0/24 &middot; the house
          </text>
          <rect class="theirs" x="402" y="396" width="310" height="92" rx="10"
          ></rect>
          <text class="house-label" x="418" y="416">
            192.168.0.0/24 &middot; next door
          </text>
        </g>

        <g class="wires">
          {
            LINKS.map(l => (
              <g class="link" data-link={l.id}>
                <line
                  class:list={["wire", { idle: l.idle }]}
                  x1={pos[l.from].x}
                  y1={pos[l.from].y}
                  x2={pos[l.to].x}
                  y2={pos[l.to].y}
                />
                <line
                  class="hit"
                  x1={pos[l.from].x}
                  y1={pos[l.from].y}
                  x2={pos[l.to].x}
                  y2={pos[l.to].y}
                />
              </g>
            ))
          }
        </g>

        <g class="nodes">
          {
            NODES.map(n => (
              <g
                class="node"
                data-node={n.id}
                transform={`translate(${pos[n.id].x} ${pos[n.id].y}) scale(1.45)`}
                tabindex="0"
                role="button"
                aria-label={`${n.name}: ${n.role}`}
              >
                <circle class="hit-dot" r="34" />
                <circle class="halo" r="24" />
                {n.id === "laptop" && (
                  <path
                    class="glyph"
                    d="M-16 -10h32v18h-32zM-22 10h44l-3 5h-38z"
                  />
                )}
                {(n.id === "phone" || n.id === "neighbour") && (
                  <path class="glyph" d="M-8 -13h16v26h-16zM-3 9h6" />
                )}
                {n.id === "printer" && (
                  <path
                    class="glyph"
                    d="M-13 -2h26v11h-26zM-8 -2v-8h16v8M-8 9v6h16v-6"
                  />
                )}
                {n.id === "switch" && (
                  <path
                    class="glyph"
                    d="M-18 -6h36v14h-36zM-12 8v5M-4 8v5M4 8v5M12 8v5"
                  />
                )}
                {(n.id === "router" || n.id === "neighbour-router") && (
                  <path
                    class="glyph"
                    d="M-18 -2h36v12h-36zM-10 -2l-6 -14M10 -2l6 -14"
                  />
                )}
                {n.id === "isp" && (
                  <path
                    class="glyph"
                    d="M0 12v-22M-12 12l12 -22l12 22M-7 -14a9 9 0 0 1 14 0"
                  />
                )}
                {(n.id === "resolver" || n.id === "server") && (
                  <path
                    class="glyph"
                    d="M-14 -12h28v10h-28zM-14 2h28v10h-28zM-9 -7h4M-9 7h4"
                  />
                )}
                <text class="name" y="40">
                  {n.name}
                </text>
              </g>
            ))
          }
        </g>

        <g class="packets" aria-hidden="true"></g>
      </svg>

      <div class="transport">
        <button id="play" type="button" aria-label="Play">Play</button>
        <input
          id="scrub"
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          aria-label="Time"
        />
        <span class="clock"><span id="clock-ms">0.00</span> ms</span>
        <span class="speeds">
          <button type="button" data-speed="0.25">&frac14;&times;</button>
          <button type="button" data-speed="1" class="on">1&times;</button>
          <button type="button" data-speed="4">4&times;</button>
        </span>
      </div>
      <p class="map-hint">
        These are virtual milliseconds, slowed down about forty times. Space
        plays, arrows nudge.
      </p>

      <!-- Where the clock is, and a way to put it somewhere else. Filled at
           runtime because the times come out of the schedule. -->
      <ol class="steps" id="steps"></ol>
    </div>

    <aside class="sidebar" id="sidebar" aria-live="polite">
      <p class="label" id="side-kind">Following the packet</p>
      <div id="side-body">
        <p class="side-empty">Loading the simulation.</p>
      </div>
    </aside>
  </section>

  <Footer />

  <!-- Data, not code: is:inline keeps Astro's bundler out of it. -->
  <script
    is:inline
    type="application/json"
    id="flow"
    set:html={JSON.stringify(payload)}
  />

  <script>
    type Field = {
      name: string;
      value: string;
      note: string | null;
      hex: string;
    };
    type Block = {
      osi: number;
      name: string;
      summary: string;
      offWire: boolean;
      fields: Field[];
    };
    type Effects = {
      switchLearn: { mac: string; port: number; who: string } | null;
      arpLearn: { on: string; ip: string; mac: string; who: string } | null;
      nat: {
        proto: string;
        inside: string;
        outside: string;
        why: string;
      } | null;
    };
    type Tick = {
      step: number;
      hop: number;
      label: string;
      link: string;
      from: string;
      to: string;
      ms: number;
      changed: string | null;
      effects: Effects;
      blocks: Block[];
    };
    type NodeInfo = {
      name: string;
      role: string;
      reads: string;
      about: string;
      ifaces: { name: string; mac?: string; ip?: string; note?: string }[];
      x: number;
      y: number;
    };
    type LinkInfo = {
      id: string;
      from: string;
      to: string;
      medium: string;
      mtu: number;
      idle: boolean;
      ms: number;
    };
    type Flow = {
      nodes: Record<string, NodeInfo>;
      links: LinkInfo[];
      think: Record<string, number>;
      steps: { id: string; label: string; summary: string }[];
      ticks: Tick[];
    };

    /** one scheduled crossing of one cable by one packet */
    type Flight = {
      id: string;
      tick: number | null;
      label: string;
      link: string;
      from: string;
      to: string;
      t0: number;
      t1: number;
      /** the phone's own traffic: present, and not the subject */
      bg: boolean;
      /** a copy the switch flooded out of a port nobody asked about */
      flood?: boolean;
    };

    type World = {
      macTable: { mac: string; port: number; who: string }[];
      arp: Record<string, { ip: string; mac: string; who: string }[]>;
      nat: { proto: string; inside: string; outside: string; why: string }[];
    };

    type Selection =
      | { kind: "node"; id: string }
      | { kind: "link"; id: string }
      /**
       * A clicked packet pins the STEP, not the one crossing. Pinning the
       * crossing freezes the panel the moment that hop lands, which is the
       * opposite of what clicking a moving thing means: the reader picked it
       * to follow it, so the panel follows it from cable to cable and stops
       * on the last hop when it arrives.
       */
      | { kind: "packet"; step: number; bg: boolean }
      | { kind: "auto" };

    const start = () => {
      const data = document.getElementById("flow");
      const svg = document.querySelector<SVGSVGElement>(".map");
      if (!data || !svg) return;

      const flow: Flow = JSON.parse(data.textContent ?? "{}");
      const { nodes, links, think, ticks } = flow;
      const linkById: Record<string, LinkInfo> = Object.fromEntries(
        links.map(l => [l.id, l]),
      );

      /* ── the schedule ─────────────────────────────────────────────────
         Built once, in virtual milliseconds. Causality is one cursor: a hop
         departs only after the hop before it landed and the device it landed
         on finished thinking. */

      const flights: Flight[] = [];
      let cursor = 0;

      ticks.forEach((tick, i) => {
        if (tick.hop === 0) cursor += think[tick.from] ?? 0.1;
        const t0 = cursor;
        const t1 = t0 + tick.ms;
        flights.push({
          id: `t${i}`,
          tick: i,
          label: tick.label,
          link: tick.link,
          from: tick.from,
          to: tick.to,
          t0,
          t1,
          bg: false,
        });
        /* A broadcast goes out of every port, and the sidebar says so, so
           the map has to show it: the same frame, at the same moment, to the
           machines that will look at it and drop it. Copies only — nothing
           learns from a frame it discards. */
        if (
          tick.link === "trunk" &&
          tick.from === "switch" &&
          tick.label.startsWith("ARP · who has")
        ) {
          (["lan-phone", "lan-printer"] as const).forEach((link, k) => {
            flights.push({
              id: `flood${i}-${k}`,
              tick: i,
              label: "",
              link,
              from: "switch",
              to: link === "lan-phone" ? "phone" : "printer",
              t0,
              t1: t0 + linkById[link].ms,
              bg: false,
              flood: true,
            });
          });
        }

        cursor = t1 + (think[tick.to] ?? 0.1);
      });

      const END = cursor + 5;

      /**
       * Two streams of traffic that are nothing to do with the request, and
       * are the reason the map is a network rather than a line: the phone
       * upstairs, and another customer two doors down loading the same site.
       * The second one ends at the server, so the far end is visibly holding
       * more than one connection at a time.
       */
      const BG_EVERY = 9;
      for (let launch = 1.5, n = 0; launch < END; launch += BG_EVERY, n++) {
        const path: [string, string, string][] = [
          ["lan-phone", "phone", "switch"],
          ["trunk", "switch", "router"],
          ["wan", "router", "isp"],
        ];
        let c = launch;
        path.forEach(([link, from, to], k) => {
          const ms = linkById[link].ms;
          flights.push({
            id: `bg${n}-${k}`,
            tick: null,
            label: "Phone · a connection of its own",
            link,
            from,
            to,
            t0: c,
            t1: c + ms,
            bg: true,
          });
          c += ms + (think[to] ?? 0.1);
        });
      }

      for (let launch = 4, n = 0; launch < END; launch += 7.5, n++) {
        const path: [string, string, string][] = [
          ["their-lan", "neighbour", "neighbour-router"],
          ["street", "neighbour-router", "isp"],
          ["core-web", "isp", "server"],
        ];
        let c = launch;
        path.forEach(([link, from, to], k) => {
          const ms = linkById[link].ms;
          flights.push({
            id: `nb${n}-${k}`,
            tick: null,
            label: "Next door · loading the same site",
            link,
            from,
            to,
            t0: c,
            t1: c + ms,
            bg: true,
          });
          c += ms + (think[to] ?? 0.1);
        });
      }

      flights.sort((a, b) => a.t0 - b.t0);

      /* ── the world, as a fold over everything that has landed ──────── */

      /* The phone's row is already there when the page opens: it has been
         talking since before the laptop asked anything. */
      const SEED_NAT = [
        {
          proto: "TCP",
          inside: "192.168.1.57:51214",
          outside: "203.0.113.7:60002",
          why: "Phone, already connected",
        },
      ];

      const worldAt = (t: number): World => {
        const world: World = {
          macTable: [],
          arp: { laptop: [], router: [] },
          nat: [...SEED_NAT],
        };

        for (const f of flights) {
          if (f.t1 > t) continue;

          if (f.bg) {
            if (
              f.to === "switch" &&
              !world.macTable.some(m => m.who === "phone")
            ) {
              world.macTable.push({
                mac: "6e:1a:bb:04:c7:93",
                port: 2,
                who: "phone",
              });
            }
            continue;
          }

          const e = ticks[f.tick as number].effects;
          if (
            e.switchLearn &&
            !world.macTable.some(m => m.mac === e.switchLearn!.mac)
          ) {
            world.macTable.push({ ...e.switchLearn });
          }
          if (e.arpLearn) {
            const rows = world.arp[e.arpLearn.on] ?? [];
            if (!rows.some(r => r.ip === e.arpLearn!.ip)) {
              rows.push({
                ip: e.arpLearn.ip,
                mac: e.arpLearn.mac,
                who: e.arpLearn.who,
              });
            }
            world.arp[e.arpLearn.on] = rows;
          }
          if (e.nat && !world.nat.some(r => r.outside === e.nat!.outside)) {
            world.nat.push({ ...e.nat });
          }
        }
        return world;
      };

      /* ── state ──────────────────────────────────────────────────────── */

      const layer = svg.querySelector<SVGGElement>(".packets")!;
      const scrub = document.getElementById("scrub") as HTMLInputElement;
      const playBtn = document.getElementById("play") as HTMLButtonElement;
      const clockOut = document.getElementById("clock-ms")!;
      const kindOut = document.getElementById("side-kind")!;
      const bodyOut = document.getElementById("side-body")!;

      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      /** real milliseconds per virtual millisecond at 1× */
      const SLOWDOWN = 42;

      let t = 0;
      let playing = false;
      let speed = 1;
      let raf = 0;
      let lastFrame = 0;
      let selection: Selection = { kind: "auto" };
      /**
       * True when the panel pinned itself because the pointer arrived in it.
       * Reaching for a value means you want to read it, and a panel that
       * moves to the next packet mid-read is useless — so the pointer
       * entering pins what is on screen, and leaving hands it back.
       */
      let pinnedByPointer = false;
      /**
       * The hovered field, held as STATE rather than as a class on a node.
       * A class is wiped by the next rebuild of the panel; the reader's
       * pointer is not, so the highlight has to be re-applied after every
       * write rather than painted once.
       */
      let litField: number | null = null;
      /** which header the packet panel is opened at; innermost by default */
      let pickedBlock = Infinity;

      const inFlight = (now: number) =>
        flights.filter(f => now >= f.t0 && now <= f.t1);

      /** landed, and being thought about rather than travelling */
      const held = (now: number) =>
        flights.filter(f => {
          if (f.flood) return false;
          if (now < f.t1) return false;
          const next = flights.find(
            g => g.bg === f.bg && g.t0 >= f.t1 && g.from === f.to,
          );
          const until = next ? next.t0 : f.t1 + 0.8;
          return now < until;
        });

      /* ── drawing the packets ────────────────────────────────────────── */

      const drawPackets = (now: number) => {
        const live = inFlight(now);
        const sitting = held(now);
        const keep = new Set<string>();

        const put = (f: Flight, x: number, y: number, state: string) => {
          keep.add(f.id);
          let g = layer.querySelector<SVGGElement>(`[data-packet="${f.id}"]`);
          if (!g) {
            g = document.createElementNS("http://www.w3.org/2000/svg", "g");
            g.setAttribute("data-packet", f.id);
            g.innerHTML =
              `<rect class="glow" x="-24" y="-12" width="48" height="24" rx="6"></rect>` +
              `<rect class="body" x="-15" y="-7" width="30" height="14" rx="3"></rect>` +
              `<text class="tag" y="-17"></text>`;
            // outbound rides above the cable, inbound below it
            const back = ["resolver", "server", "isp"].includes(f.from);
            g.querySelector("text")!.setAttribute("y", back ? "25" : "-17");
            layer.appendChild(g);
            g.querySelector<SVGTextElement>(".tag")!.textContent = f.bg
              ? ""
              : f.label;
          }
          g.setAttribute("transform", `translate(${x} ${y})`);
          g.setAttribute(
            "class",
            [
              "packet",
              f.bg ? "bg" : "",
              f.flood ? "flood" : "",
              state === "held" ? "held" : "",
              selection.kind === "packet" &&
              (f.tick !== null
                ? ticks[f.tick].step === selection.step
                : selection.bg)
                ? "picked"
                : "",
            ]
              .filter(Boolean)
              .join(" "),
          );
        };

        live.forEach(f => {
          const a = nodes[f.from];
          const b = nodes[f.to];
          const p = (now - f.t0) / (f.t1 - f.t0);
          put(f, a.x + (b.x - a.x) * p, a.y + (b.y - a.y) * p, "wire");
        });

        sitting.forEach(f => put(f, nodes[f.to].x, nodes[f.to].y - 32, "held"));

        layer.querySelectorAll<SVGGElement>("[data-packet]").forEach(g => {
          if (!keep.has(g.getAttribute("data-packet")!)) g.remove();
        });

        return [...live, ...sitting];
      };

      const paintMap = (visible: Flight[]) => {
        const liveLinks = new Set(visible.map(f => f.link));
        svg.querySelectorAll<SVGGElement>(".link").forEach(l => {
          const id = l.getAttribute("data-link")!;
          l.classList.toggle("live", liveLinks.has(id));
          l.classList.toggle(
            "picked",
            selection.kind === "link" && selection.id === id,
          );
        });

        const busy = new Set(visible.flatMap(f => [f.from, f.to]));
        svg.querySelectorAll<SVGGElement>(".node").forEach(n => {
          const id = n.getAttribute("data-node")!;
          n.classList.toggle("active", busy.has(id));
          n.classList.toggle(
            "picked",
            selection.kind === "node" && selection.id === id,
          );
        });
      };

      /* ── the sidebar ────────────────────────────────────────────────── */

      const bytesIn = (b: Block) =>
        b.fields.reduce((n, f) => n + f.hex.length / 2, 0);

      const hexOf = (tick: Tick) => {
        let fieldNo = 0;
        const cells: string[] = [];
        tick.blocks.forEach((block, bi) => {
          block.fields.forEach(field => {
            if (!block.offWire) {
              (field.hex.match(/../g) ?? []).forEach(b =>
                cells.push(
                  `<span class="b" data-field="${fieldNo}" data-block="${bi}">${b}</span>`,
                ),
              );
            }
            fieldNo += 1;
          });
        });
        return cells.join("");
      };

      const packetPanel = (f: Flight) => {
        if (f.tick === null) {
          return (
            `<p class="side-lead">The phone, keeping a connection of its own ` +
            `alive. It is here so the map is a network and not a diagram, and ` +
            `so the router's table has a row the laptop did not put there.</p>`
          );
        }

        const tick = ticks[f.tick];
        const wire = tick.blocks.filter(b => !b.offWire);
        const total = wire.reduce((n, b) => n + bytesIn(b), 0);
        const bi = Math.min(pickedBlock, tick.blocks.length - 1);
        const block = tick.blocks[bi];
        let fieldNo = 0;
        tick.blocks.forEach((b, i) => {
          if (i < bi) fieldNo += b.fields.length;
        });

        return (
          `<p class="side-lead">${flow.steps[tick.step].summary}</p>` +
          `<p class="side-wire"><b>${nodes[tick.from].name}</b> &rarr; ` +
          `<b>${nodes[tick.to].name}</b> <span>${linkById[tick.link].medium} · ` +
          `${tick.ms} ms</span></p>` +
          (tick.changed
            ? `<p class="changed">${tick.changed}</p>`
            : `<p class="changed quiet">Nothing was rewritten on this hop.</p>`) +
          `<p class="label sub">On the wire <span class="size">${total} bytes</span></p>` +
          `<div class="encap">` +
          wire
            .map(b => {
              const i = tick.blocks.indexOf(b);
              return (
                `<span class="seg${i === bi ? " lit" : ""}" data-block="${i}" ` +
                `style="flex: ${bytesIn(b)} 1 0">` +
                `<span class="seg-name">${b.name}</span>` +
                `<span class="seg-bytes">${bytesIn(b)}</span></span>`
              );
            })
            .join("") +
          `</div>` +
          `<div class="hex">${hexOf(tick)}</div>` +
          `<div class="fields">` +
          `<div class="block-head${block.offWire ? " off-wire" : ""}">` +
          `<span class="layer-no">L${block.osi}</span>` +
          `<span class="block-name">${block.name}</span>` +
          `<span class="block-summary">${block.summary}${
            block.offWire
              ? " <b>Not on the wire</b> — this is what the application handed to TLS."
              : ""
          }</span></div>` +
          block.fields
            .map(
              (field, i) =>
                `<div class="row" data-field="${fieldNo + i}" data-block="${bi}">` +
                `<dt>${field.name}</dt><dd>${field.value}` +
                (field.note ? `<em>${field.note}</em>` : "") +
                `</dd></div>`,
            )
            .join("") +
          `</div>`
        );
      };

      /**
       * What the run cost, once it is over. The split is the point: almost
       * all of it was the wire and the far end, and the two round trips
       * before a single byte of the page was asked for are the reason a
       * cold load feels slow on a connection that is not.
       */
      const donePanel = () => {
        const real = flights.filter(f => !f.bg && !f.flood);
        const onWire = real.reduce((n, f) => n + (f.t1 - f.t0), 0);
        const firstByte = real[real.length - 1]?.t1 ?? 0;
        const handshakes = real
          .filter(f => f.tick !== null && ticks[f.tick].step <= 5)
          .reduce((n, f) => n + (f.t1 - f.t0), 0);

        return (
          `<p class="side-lead">The page arrived after <b>${firstByte.toFixed(1)} ms</b>. ` +
          `Of that, <b>${onWire.toFixed(1)} ms</b> was cable. The rest was devices ` +
          `thinking, and nearly all of that was the server.</p>` +
          `<div class="fields">` +
          `<div class="row"><dt>Cables crossed</dt><dd>${real.length}</dd></div>` +
          `<div class="row"><dt>Before the request</dt><dd>${handshakes.toFixed(1)} ms` +
          `<em>Finding the address, opening the connection and agreeing a key. All of ` +
          `it happens before one byte of the page is even asked for. That is why a cold ` +
          `load feels slow on a connection that is not.</em></dd></div>` +
          `<div class="row"><dt>Round trips</dt><dd>four<em>DNS, the handshake, the TLS ` +
          `hello, then the request. Each one pays the distance to the far end again. ` +
          `A real TLS 1.3 handshake adds one more exchange, which this page does not draw.` +
          `</em></dd></div>` +
          `</div>` +
          `<p class="side-note">Drag the line back, or click a device to see what it learned.</p>`
        );
      };

      const applyLit = () => {
        bodyOut
          .querySelectorAll<HTMLElement>(".b")
          .forEach(b =>
            b.classList.toggle("lit", Number(b.dataset.field) === litField),
          );
        bodyOut
          .querySelectorAll<HTMLElement>(".row")
          .forEach(r =>
            r.classList.toggle("lit", Number(r.dataset.field) === litField),
          );
      };

      const table = (head: string[], rows: string[][], empty: string) =>
        rows.length
          ? `<table class="t"><thead><tr>${head
              .map(h => `<th>${h}</th>`)
              .join("")}</tr></thead><tbody>${rows
              .map(r => `<tr>${r.map(c => `<td>${c}</td>`).join("")}</tr>`)
              .join("")}</tbody></table>`
          : `<p class="side-empty">${empty}</p>`;

      const nodePanel = (id: string, world: World) => {
        const n = nodes[id];
        const ifaces = n.ifaces
          .map(
            i =>
              `<div class="row"><dt>${i.name}</dt><dd>${[i.ip, i.mac]
                .filter(Boolean)
                .join(" · ")}${i.note ? `<em>${i.note}</em>` : ""}</dd></div>`,
          )
          .join("");

        let extra = "";
        if (id === "switch") {
          extra =
            `<p class="label sub">MAC table <span class="size">learned by listening</span></p>` +
            table(
              ["Address", "Port", "Device"],
              world.macTable.map(m => [
                `<code>${m.mac}</code>`,
                `${m.port}`,
                nodes[m.who].name,
              ]),
              "Empty. It has heard nobody yet, so a frame arriving now would go out of every port.",
            ) +
            `<p class="side-note">The printer is not in this table, and will not be until it speaks. A switch only knows what it has overheard.</p>`;
        }
        if (id === "router") {
          extra =
            `<p class="label sub">NAT table</p>` +
            table(
              ["Inside", "Outside", "For"],
              world.nat.map(r => [
                `<code>${r.inside}</code>`,
                `<code>${r.outside}</code>`,
                r.why,
              ]),
              "No translations yet.",
            ) +
            `<p class="side-note">Two machines, one public address. The port in the right-hand column is the only thing that tells them apart on the way back.</p>` +
            `<p class="label sub">ARP cache</p>` +
            table(
              ["Address", "Hardware"],
              (world.arp.router ?? []).map(r => [
                r.ip,
                `<code>${r.mac}</code>`,
              ]),
              "Empty.",
            );
        }
        if (id === "laptop") {
          extra =
            `<p class="label sub">ARP cache</p>` +
            table(
              ["Address", "Hardware", "Who"],
              (world.arp.laptop ?? []).map(r => [
                r.ip,
                `<code>${r.mac}</code>`,
                nodes[r.who].name,
              ]),
              "Empty — which is why the first thing that happens on this page is a question shouted at the whole segment.",
            );
        }
        if (id === "server") {
          const mine = world.nat.find(r => r.why === "SYN");
          extra =
            `<p class="label sub">Connections it is holding</p>` +
            table(
              ["From", "Port", "Who it thinks that is"],
              [
                ...(mine
                  ? [
                      [
                        `<code>${mine.outside.split(":")[0]}</code>`,
                        mine.outside.split(":")[1],
                        "one customer of that ISP — it cannot tell which machine",
                      ],
                    ]
                  : []),
                [
                  "<code>198.51.100.23</code>",
                  "49211",
                  "another customer, two doors down",
                ],
              ],
              "Nothing yet.",
            ) +
            `<p class="side-note">Both rows are routers, not people. The server has never seen a private address, and could not reach one if it tried.</p>`;
        }
        if (id === "printer") {
          extra = `<p class="side-note">Silent since it was plugged in. Nothing here is addressed to it, and the switch has no row for it.</p>`;
        }

        return (
          `<p class="side-lead">${n.about}</p>` +
          `<p class="label sub">Interfaces <span class="size">reads ${n.reads}</span></p>` +
          `<div class="fields">${ifaces}</div>` +
          extra
        );
      };

      const linkPanel = (id: string, now: number) => {
        const l = linkById[id];
        const on = inFlight(now).filter(f => f.link === id);
        return (
          `<p class="side-lead">${l.medium}. One way, ${l.ms} ms — ${
            l.ms < 1
              ? "short enough that the cable is never the thing you wait for."
              : "long enough that it is most of what you wait for."
          }</p>` +
          `<div class="fields">` +
          `<div class="row"><dt>Between</dt><dd>${nodes[l.from].name} and ${nodes[l.to].name}</dd></div>` +
          `<div class="row"><dt>MTU</dt><dd>${l.mtu} bytes<em>The largest payload one frame can carry here. Anything longer has to be split up first.</em></dd></div>` +
          `<div class="row"><dt>One-way delay</dt><dd>${l.ms} ms</dd></div>` +
          `<div class="row"><dt>Carrying now</dt><dd>${
            on.length ? on.map(f => f.label).join(", ") : "nothing"
          }</dd></div>` +
          `</div>`
        );
      };

      /**
       * The panel is rebuilt only when what it SAYS changes. It used to be
       * rewritten on every animation frame, which cost sixty innerHTML
       * writes a second and — worse — replaced the DOM under the reader's
       * cursor, so a hovered byte lost its highlight within one frame. The
       * clock and the map still move at sixty; the prose does not.
       */
      let lastKey = "";

      const paintSidebar = (now: number, visible: Flight[]) => {
        if (selection.kind === "node") {
          const world = worldAt(now);
          const key = [
            "node",
            selection.id,
            world.macTable.length,
            world.nat.length,
            (world.arp.laptop ?? []).length,
            (world.arp.router ?? []).length,
          ].join("|");
          if (key === lastKey) return;
          lastKey = key;
          kindOut.textContent = nodes[selection.id].name;
          bodyOut.innerHTML = nodePanel(selection.id, world);
          applyLit();
          return;
        }

        if (selection.kind === "link") {
          /* bound before the callback: narrowing does not survive a closure */
          const linkId = selection.id;
          const carrying = inFlight(now)
            .filter(f => f.link === linkId)
            .map(f => f.id)
            .join(",");
          const key = ["link", linkId, carrying].join("|");
          if (key === lastKey) return;
          lastKey = key;
          kindOut.textContent = linkById[linkId].medium.split(" · ")[0];
          bodyOut.innerHTML = linkPanel(linkId, now);
          applyLit();
          return;
        }

        let pick: Flight | null;
        if (selection.kind === "packet") {
          /* bound before the callback: a `let` of a union type does not stay
             narrowed inside a closure */
          const sel = selection;
          const mine = flights.filter(f =>
            sel.bg ? f.bg : f.tick !== null && ticks[f.tick].step === sel.step,
          );
          pick =
            mine.find(f => t >= f.t0 && t <= f.t1) ??
            [...mine].reverse().find(f => f.t1 <= t) ??
            mine[0] ??
            null;
        } else {
          pick = visible.find(f => !f.bg) ?? null;
        }

        if (!pick) {
          const key = t >= END ? "done" : "idle";
          if (key === lastKey) return;
          lastKey = key;
          if (t >= END) {
            kindOut.textContent = "Done";
            bodyOut.innerHTML = donePanel();
          } else {
            kindOut.textContent = "Nothing in flight";
            bodyOut.innerHTML = `<p class="side-empty">Press play, or click a device to look inside it.</p>`;
          }
          return;
        }

        const key = ["packet", pick.id, pickedBlock].join("|");
        if (key === lastKey) return;
        lastKey = key;
        kindOut.textContent = pick.label;
        bodyOut.innerHTML = packetPanel(pick);
        applyLit();
      };

      /* ── the loop ───────────────────────────────────────────────────── */

      /* The step strip, built once from the schedule: each step's first
         departure is a time the reader can jump to. */
      const stepsEl = document.getElementById("steps")!;
      const stepStart = new Map<number, number>();
      flights.forEach(f => {
        if (f.tick === null) return;
        const s = ticks[f.tick].step;
        if (!stepStart.has(s)) stepStart.set(s, f.t0);
      });
      stepsEl.innerHTML = [...stepStart.entries()]
        .map(
          ([i, at]) =>
            `<li data-step="${i}" data-at="${at}">` +
            `<b>${flow.steps[i].label}</b><span>${at.toFixed(1)} ms</span></li>`,
        )
        .join("");
      stepsEl.addEventListener("click", e => {
        const li = (e.target as HTMLElement).closest<HTMLElement>("[data-at]");
        if (!li) return;
        setPlaying(false);
        t = Number(li.dataset.at) + 0.001;
        selection = { kind: "auto" };
        render();
      });

      const paintSteps = (now: number) => {
        let current = -1;
        stepStart.forEach((at, i) => {
          if (now >= at) current = i;
        });
        stepsEl.querySelectorAll<HTMLElement>("li").forEach(li => {
          li.classList.toggle("on", Number(li.dataset.step) === current);
          li.classList.toggle("done", Number(li.dataset.step) < current);
        });
      };

      const render = () => {
        const visible = drawPackets(t);
        paintMap(visible);
        paintSteps(t);
        paintSidebar(t, visible);
        clockOut.textContent = t.toFixed(2);
        scrub.value = String(Math.round((t / END) * 1000));
      };

      const frame = (now: number) => {
        if (!playing) return;
        const dt = Math.min(64, now - lastFrame);
        lastFrame = now;
        t += (dt / SLOWDOWN) * speed;
        if (t >= END) {
          t = END;
          setPlaying(false);
          render();
          return;
        }
        render();
        raf = requestAnimationFrame(frame);
      };

      function setPlaying(on: boolean) {
        playing = on && !reduced;
        playBtn.textContent = playing ? "Pause" : "Play";
        playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
        if (playing) {
          lastFrame = performance.now();
          raf = requestAnimationFrame(frame);
        } else {
          cancelAnimationFrame(raf);
        }
      }

      const select = (s: Selection) => {
        selection = s;
        pinnedByPointer = false;
        pickedBlock = Infinity;
        lastKey = "";
        render();
      };

      playBtn.addEventListener("click", () => {
        if (!playing && t >= END) t = 0;
        setPlaying(!playing);
      });

      scrub.addEventListener("input", () => {
        setPlaying(false);
        t = (Number(scrub.value) / 1000) * END;
        render();
      });

      document
        .querySelectorAll<HTMLButtonElement>("[data-speed]")
        .forEach(b => {
          b.addEventListener("click", () => {
            speed = Number(b.dataset.speed);
            document
              .querySelectorAll("[data-speed]")
              .forEach(o => o.classList.toggle("on", o === b));
          });
        });

      svg.addEventListener("click", e => {
        const el = e.target as Element;
        const packet = el.closest<SVGGElement>("[data-packet]");
        if (packet) {
          const f = flights.find(
            g => g.id === packet.getAttribute("data-packet"),
          );
          if (f) {
            select(
              f.tick === null
                ? { kind: "packet", step: -1, bg: true }
                : { kind: "packet", step: ticks[f.tick].step, bg: false },
            );
          }
          return;
        }
        const node = el.closest<SVGGElement>("[data-node]");
        if (node) {
          select({ kind: "node", id: node.getAttribute("data-node")! });
          return;
        }
        const link = el.closest<SVGGElement>("[data-link]");
        if (link) {
          select({ kind: "link", id: link.getAttribute("data-link")! });
          return;
        }
        select({ kind: "auto" });
      });

      svg.addEventListener("keydown", e => {
        if (e.key !== "Enter" && e.key !== " ") return;
        const node = (e.target as Element).closest<SVGGElement>("[data-node]");
        if (!node) return;
        e.preventDefault();
        select({ kind: "node", id: node.getAttribute("data-node")! });
      });

      bodyOut.addEventListener("pointerenter", () => {
        if (selection.kind !== "auto") return;
        const pick = inFlight(t).find(f => !f.bg && !f.flood);
        if (!pick || pick.tick === null) return;
        selection = { kind: "packet", step: ticks[pick.tick].step, bg: false };
        pinnedByPointer = true;
        lastKey = "";
        render();
      });

      bodyOut.addEventListener("pointerleave", () => {
        litField = null;
        applyLit();
        if (!pinnedByPointer) return;
        pinnedByPointer = false;
        selection = { kind: "auto" };
        lastKey = "";
        render();
      });

      /* Pointing at a header in the sidebar opens it, and lights its bytes. */
      bodyOut.addEventListener("pointerover", e => {
        const el = e.target as HTMLElement;
        const which =
          el.closest<HTMLElement>(".seg") ?? el.closest<HTMLElement>(".b");
        if (!which) return;
        const block = Number(which.dataset.block);
        if (block !== pickedBlock) {
          pickedBlock = block;
          render();
        }
        const cell = el.closest<HTMLElement>(".b");
        if (cell) {
          const f = Number(cell.dataset.field);
          bodyOut
            .querySelectorAll<HTMLElement>(".b")
            .forEach(b =>
              b.classList.toggle("lit", Number(b.dataset.field) === f),
            );
          bodyOut
            .querySelectorAll<HTMLElement>(".row")
            .forEach(r =>
              r.classList.toggle("lit", Number(r.dataset.field) === f),
            );
        }
      });

      const keys = (e: KeyboardEvent) => {
        const typing = (e.target as HTMLElement)?.closest("input, textarea");
        if (e.key === " " && !typing) {
          e.preventDefault();
          setPlaying(!playing);
        } else if (e.key === "ArrowRight") {
          setPlaying(false);
          t = Math.min(END, t + 0.4);
          render();
        } else if (e.key === "ArrowLeft") {
          setPlaying(false);
          t = Math.max(0, t - 0.4);
          render();
        }
      };
      document.addEventListener("keydown", keys);
      document.addEventListener("astro:before-swap", () => {
        cancelAnimationFrame(raf);
        document.removeEventListener("keydown", keys);
      });

      render();
      if (!reduced) setPlaying(true);
    };

    start();
    document.addEventListener("astro:after-swap", start);
  </script>
</Layout>

<style>
  .intro {
    margin-bottom: clamp(26px, 4vh, 40px);
  }

  /* ── the bench ─────────────────────────────────────────────────────── */

  .bench {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.95fr);
    gap: clamp(20px, 2.5vw, 40px);
    width: 100%;
    max-width: 96rem;
    margin-inline: auto;
    padding-inline: clamp(22px, 6vw, 40px);
    padding-bottom: clamp(30px, 6vh, 60px);
  }

  .map {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* The one boundary on the map that changes what an address means. */
  .house rect {
    fill: none;
    stroke: var(--border);
    stroke-dasharray: 3 7;
  }

  /* Their house is drawn fainter: it is context, not the subject. */
  .house rect.theirs {
    opacity: 0.6;
  }

  .house-label {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.06em;
    fill: var(--text-4);
  }

  .wire {
    stroke: var(--border);
    stroke-width: 1;
  }

  .wire.idle {
    stroke-dasharray: 2 6;
  }

  /* A hairline is impossible to click, so every cable carries a fat
     transparent twin. */
  .hit {
    stroke: transparent;
    stroke-width: 18;
    cursor: pointer;
  }

  .link.live .wire {
    stroke: var(--text-4);
    stroke-width: 1.4;
  }

  .link.picked .wire {
    stroke: var(--arcane);
  }

  .glyph {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .halo {
    fill: var(--ground);
  }

  .hit-dot {
    fill: transparent;
    cursor: pointer;
  }

  .node .name {
    font-family: var(--font-display);
    font-size: 14px;
    fill: var(--text-3);
    text-anchor: middle;
  }

  .node.active .glyph,
  .node:hover .glyph {
    stroke: var(--text);
  }

  .node.picked .glyph {
    stroke: var(--arcane);
  }

  .node.picked .name {
    fill: var(--arcane);
  }

  .node:focus-visible {
    outline: none;
  }

  .node:focus-visible .glyph {
    stroke: var(--torch);
  }

  /* The packet is the page's one gold. Background traffic is not gold,
     because it is not the thing being followed. */
  .packets :global(.packet .body) {
    fill: var(--torch);
    cursor: pointer;
  }

  .packets :global(.packet .glow) {
    fill: var(--torch-tint);
    cursor: pointer;
  }

  .packets :global(.packet .tag) {
    font-family: var(--font-display);
    font-size: 12.5px;
    fill: var(--text-3);
    text-anchor: middle;
  }

  .packets :global(.packet.bg .body) {
    fill: var(--text-4);
  }

  .packets :global(.packet.bg .glow) {
    fill: none;
  }

  /* A flooded copy: the same frame, on its way to a machine that will look
     at it and drop it. */
  .packets :global(.packet.flood .body) {
    fill: var(--torch-dim);
    opacity: 0.5;
  }

  .packets :global(.packet.flood .glow) {
    fill: none;
  }

  /* Landed, and being thought about rather than travelling. */
  .packets :global(.packet.held .body) {
    fill: var(--torch-dim);
  }

  .packets :global(.packet.picked .glow) {
    fill: var(--arcane-tint);
  }

  /* ── transport ─────────────────────────────────────────────────────── */

  .transport {
    display: flex;
