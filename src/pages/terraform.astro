      color: var(--text-4);
      font-size: 14.5px;
    }
    .toc a:hover {
      color: var(--text-2);
    }
    .toc-n {
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--text-4);
      opacity: 0.7;
    }
    .toc li.done a {
      color: var(--text-3);
    }
    .toc li.on {
      border-top-color: var(--ornament);
    }
    .toc li.on a {
      color: var(--text);
    }

    /* ── the guide ──────────────────────────────────────────────────── */
    .guide {
      width: 100%;
      max-width: 1240px;
      margin-inline: auto;
      padding-inline: 16px;
      padding-block: 34px 0;
      display: grid;
      grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
      gap: 40px;
      align-items: start;
    }
    .guide-rail {
      position: sticky;
      top: 24px;
      min-width: 0;
      /* The pane's contents change as the reader scrolls, and a sticky box
         whose contents change is exactly the case Chrome's scroll
         anchoring mishandles: it compensates for the size change by
         moving the document, which fights the scroll that caused it. */
      overflow-anchor: none;
    }
    .label {
      font-family: var(--font-display);
      font-size: 13px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-4);
      margin: 0 0 8px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    .label.sub {
      margin-top: 18px;
    }
    .rail-step {
      font-family: var(--font-mono);
      letter-spacing: 0.04em;
      text-transform: none;
    }

    .code,
    .shell,
    .term-run {
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.55;
      margin: 0;
      overflow: auto;
      white-space: pre;
      color: var(--syn-plain);
      background: none;
    }
    .guide-file {
      max-height: 52vh;
      overflow-y: auto;
      scrollbar-width: thin;
      border-left: 1px solid var(--border-recess);
      padding-left: 14px;
    }
    .guide-file[data-empty="true"]::after {
      content: "no file yet — step 2 writes the first line";
      color: var(--text-4);
      font-style: italic;
    }
    /* A line that has not arrived is removed, not merely made invisible:
       held open it reads as a blank line in the file, which is worse than
       the pane growing. Growing is the point. */
    .guide-file :global(.ln) {
      display: none;
    }
    .guide-file :global(.ln.shown) {
      display: block;
    }
    .guide-file :global(.ln.fresh) {
