---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import rawItems from "@/data/list.json";

type ListItem = {
  name: string;
  link?: string;
  type: "movie" | "anime" | "manga" | "article";
  status: "done" | "todo";
  date?: string;
};

const items = (rawItems as ListItem[]).sort((a, b) => {
  if (!a.date && !b.date) return 0;
  if (!a.date) return 1;
  if (!b.date) return -1;
  return b.date.localeCompare(a.date);
});

const types = ["all", "movie", "anime", "manga", "article"] as const;
const statuses = ["all", "todo", "done"] as const;

const label = (value: string) => value.charAt(0).toUpperCase() + value.slice(1);
---

<Layout
  title={`List | ${config.site.title}`}
  description="Movies, anime, manga, and articles to watch or read."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle="List" pageDesc="Things watched, read, or waiting.">
    <div class="filters">
      <div class="row" role="group" aria-label="Filter by type">
        {
          types.map(type => (
            <button
              class:list={["filter type-filter", { active: type === "all" }]}
              data-type={type}
              type="button"
            >
              {label(type)}
            </button>
          ))
        }
      </div>

      <div class="row" role="group" aria-label="Filter by status">
        {
          statuses.map(status => (
            <button
              class:list={[
                "filter status-filter",
                { active: status === "all" },
              ]}
              data-status={status}
              type="button"
            >
              {label(status)}
            </button>
          ))
        }
      </div>
    </div>

    <ul class="items">
      {
        items.map(item => (
          <li class="list-item" data-type={item.type} data-status={item.status}>
            <span class="kind">{label(item.type)}</span>

            {item.link ? (
              <a
                class="name"
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.name}
              </a>
            ) : (
              <span class="name">{item.name}</span>
            )}

            <span class:list={["state", item.status]}>
              {label(item.status)}
            </span>

            {item.date && <span class="when">{item.date}</span>}
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 34px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* Filters are words, in the HUD voice. The active one is simply brighter —
     no pill, no fill, no gold. */
  .filter {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0 0 4px;
    color: var(--text-4);
    transition: color 0.18s ease-out;
  }

  .filter:hover {
    color: var(--text-2);
  }

  .filter.active {
    color: var(--text);
    border-bottom-color: var(--border);
  }

  .items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }

  /* Type is told apart by its label, never by colour alone. */
  .kind {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-4);
    min-width: 7ch;
  }

  .name {
    flex: 1;
    min-width: 14ch;
    color: var(--text-2);
    text-decoration: none;
  }

  a.name {
    text-decoration: underline;
    text-decoration-color: var(--text-4);
    text-underline-offset: 4px;
  }

  a.name:hover {
    color: var(--torch);
    text-decoration-color: var(--torch-dim);
  }

  .state {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-4);
  }

  .state.done {
    color: var(--text-3);
  }

  .when {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--text-4);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  function setupFilters() {
    const typeFilters = document.querySelectorAll<HTMLElement>(".type-filter");
    const statusFilters =
      document.querySelectorAll<HTMLElement>(".status-filter");
    const listItems = document.querySelectorAll<HTMLElement>(".list-item");

    if (!listItems.length) return;

    let activeType = "all";
    let activeStatus = "all";

    function updateItems() {
      listItems.forEach(item => {
        const typeMatch =
          activeType === "all" || item.dataset.type === activeType;
        const statusMatch =
          activeStatus === "all" || item.dataset.status === activeStatus;
        item.style.display = typeMatch && statusMatch ? "" : "none";
      });
    }

    typeFilters.forEach(btn => {
      btn.addEventListener("click", () => {
        typeFilters.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeType = btn.dataset.type || "all";
        updateItems();
      });
    });

    statusFilters.forEach(btn => {
      btn.addEventListener("click", () => {
        statusFilters.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeStatus = btn.dataset.status || "all";
        updateItems();
      });
    });
  }

  setupFilters();
  document.addEventListener("astro:after-swap", setupFilters);
</script>
