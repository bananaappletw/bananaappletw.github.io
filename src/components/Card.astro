---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;

// Every post in this collection currently carries description === title, so
// rendering both prints the same line twice. Show the description only when
// it actually says something new.
const norm = (value: string) => value.trim().toLowerCase();
const showDescription =
  Boolean(description) && norm(description!) !== norm(title);
---

<li>
  <a href={getPostUrl(id, filePath, Astro.currentLocale)} class="entry">
    <Heading class="t" transition:name={slugifyStr(title.replaceAll(".", "-"))}>
      {title}
    </Heading>
    <Datetime {...props} class="meta" />
    {showDescription && <span class="d">{description}</span>}
  </a>
</li>

<style>
  .entry {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  /* Listing titles are NOT gold. A list of gold titles is wallpaper;
     gold has to stay rare to read as relief. */
  .t {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 0.68vw + 17.45px, 24px);
    letter-spacing: 0.03em;
    font-variant-caps: small-caps;
    line-height: 1.35;
    color: var(--text-3);
    margin: 0;
    transition: color 0.18s ease-out;
  }

  .entry:hover .t {
    color: var(--text);
  }

  .d {
    font-size: clamp(15px, 0.34vw + 13.7px, 17px);
    line-height: 1.65;
    color: var(--text-4);
  }

  .meta :global(time) {
    color: var(--text-4);
  }
</style>
