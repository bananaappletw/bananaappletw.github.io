---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";
import { sigil, moon, sunCore, sunRays } from "@/utils/marks";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy
// subdirectory. e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// The HUD carries the fewest words that still let a reader move. Souls
// affixes its interface to a corner and otherwise leaves the screen alone.
const links = [
  { href: "posts", label: t.nav.posts, path: "/posts" },
  { href: "tags", label: t.nav.tags, path: "/tags" },
  ...(features.showArchives
    ? [{ href: "archives", label: t.nav.archives, path: "/archives" }]
    : []),
  ...(features.search !== false
    ? [{ href: "search", label: t.nav.search, path: "/search" }]
    : []),
  { href: "list", label: t.nav.list, path: "/list" },
  { href: "about", label: t.nav.about, path: "/about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="label absolute inset-s-16 -top-full z-50 px-3 py-2 focus:top-4"
  style="background: var(--ground); color: var(--torch);"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div class="hud">
    <a href={getRelativeLocaleUrl(locale, "")} class="hud-home">
      {
        /* The sigil: the site's mark, drawn rather than constructed. Same
           family as the edit rune, and deliberately unlike it — this one is
           centred and closed where that one is asymmetric and open, so two
           runes on a page cannot be confused. It does not flicker: stone
           does not.

           Geometry comes from src/utils/marks.ts, where the lozenge is two
           crossing pen strokes rather than one mitred path. */
      }
      <svg
        class="sigil"
        viewBox="0 0 64 64"
        width="17"
        height="17"
        aria-hidden="true"
        focusable="false"
      >
        {sigil.map(d => <path d={d} />)}
      </svg>
      <span>{site.title}</span>
    </a>

    <nav aria-label={t.nav.posts}>
      {
        links.map(link => (
          <a
            href={getRelativeLocaleUrl(locale, link.href)}
            aria-current={isActive(link.path) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        features.lightAndDarkMode && (
          <button
            id="world-btn"
            type="button"
            aria-label="Dark theme. Switch to light."
          >
            {/* Moon when hollowed, sun when kindled. Only one is ever in
                the tree's paint; the other is display:none. */}
            <svg
              class="world-icon"
              viewBox="0 0 64 64"
              width="15"
              height="15"
              aria-hidden="true"
              focusable="false"
            >
              <path class="moon" d={moon} />
              <g class="sun">
                <path d={sunCore} />
                {sunRays.map(d => (
                  <path d={d} />
                ))}
              </g>
            </svg>
          </button>
        )
      }
    </nav>
  </div>
</header>

<style>
  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 18px;
    padding-top: 26px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(15.5px, 0.34vw + 14.22px, 17.5px);
    letter-spacing: 0.06em;
    color: var(--text-4);
  }

  .hud-home {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--text-4);
    text-decoration: none;
  }

  .hud-home:hover {
    color: var(--text-2);
  }

  /* Filled, not stroked. The marks are outlines of a pen stroke rather than
     stroked paths, because a stroke has exactly one width and a drawn line
     never does — see src/utils/nib.ts. One gold, spent once (§4). */
  .sigil {
    align-self: center;
    fill: var(--torch);
  }

  nav {
    margin-inline-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  nav a {
    color: var(--text-4);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text-2);
  }

  button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: var(--text-4);
    display: flex;
    align-items: center;
    align-self: center; /* the nav is baseline-aligned; the icon is not */
    line-height: 1;
  }

  button:hover {
    color: var(--text-2);
  }

  /* The moon carries the HUD's own ink, so hollowed spends no gold on the
     control at all. The sun takes --torch — the one control §4 lets have
     it, for an active state. */
  .moon {
    fill: currentColor;
  }

  .sun {
    display: none;
    fill: var(--torch);
  }

  :root[data-theme="kindled"] .moon,
  :root[data-theme="light"] .moon {
    display: none;
  }

  :root[data-theme="kindled"] .sun,
  :root[data-theme="light"] .sun {
    display: block;
  }

  @media (max-width: 620px) {
    nav {
      margin-inline-start: 0;
      width: 100%;
      padding-top: 8px;
    }
  }
</style>
