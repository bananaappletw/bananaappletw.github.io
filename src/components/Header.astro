---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy
// subdirectory. e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// The HUD carries the fewest words that still let a reader move. Souls
// affixes its interface to a corner and otherwise leaves the screen alone.
const links = [
  { href: "posts", label: t.nav.posts, path: "/posts" },
  { href: "tags", label: t.nav.tags, path: "/tags" },
  ...(features.showArchives
    ? [{ href: "archives", label: t.nav.archives, path: "/archives" }]
    : []),
  ...(features.search !== false
    ? [{ href: "search", label: t.nav.search, path: "/search" }]
    : []),
  { href: "list", label: t.nav.list, path: "/list" },
  { href: "about", label: t.nav.about, path: "/about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="label absolute inset-s-16 -top-full z-50 px-3 py-2 focus:top-4"
  style="background: var(--ground); color: var(--torch);"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div class="hud">
    <a href={getRelativeLocaleUrl(locale, "")} class="hud-home">
      {
        /* The sigil: the site's mark, cut rather than drawn. Same family as
           the edit rune, and deliberately unlike it — this one is centred
           and closed where that one is asymmetric and open, so two runes on
           a page cannot be confused. It does not flicker: stone does not. */
      }
      <svg
        class="sigil"
        viewBox="0 0 16 16"
        width="17"
        height="17"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M8 1.4V14.6"></path>
        <path d="M8 3.4 11.1 6.6 8 9.8 4.9 6.6Z"></path>
        <path d="M5.2 12.9h5.6"></path>
      </svg>
      <span>{site.title}</span>
    </a>

    <nav aria-label={t.nav.posts}>
      {
        links.map(link => (
          <a
            href={getRelativeLocaleUrl(locale, link.href)}
            aria-current={isActive(link.path) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        features.lightAndDarkMode && (
          <button
            id="world-btn"
            type="button"
            aria-label="Dark theme. Switch to light."
          >
            {/* Moon when hollowed, sun when kindled. Only one is ever in
                the tree's paint; the other is display:none. */}
            <svg
              class="world-icon"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
              focusable="false"
            >
              <path
                class="moon"
                d="M13.4 10.3A6.1 6.1 0 0 1 5.7 2.6a6.1 6.1 0 1 0 7.7 7.7z"
              />
              <g class="sun">
                <circle class="sun-core" cx="8" cy="8" r="3.2" />
                <g class="sun-ray">
                  <line x1="8" y1="1" x2="8" y2="2.6" />
                  <line x1="8" y1="13.4" x2="8" y2="15" />
                  <line x1="1" y1="8" x2="2.6" y2="8" />
                  <line x1="13.4" y1="8" x2="15" y2="8" />
                  <line x1="3.1" y1="3.1" x2="4.2" y2="4.2" />
                  <line x1="11.8" y1="11.8" x2="12.9" y2="12.9" />
                  <line x1="3.1" y1="12.9" x2="4.2" y2="11.8" />
                  <line x1="11.8" y1="4.2" x2="12.9" y2="3.1" />
                </g>
              </g>
            </svg>
          </button>
        )
      }
    </nav>
  </div>
</header>

<style>
  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 18px;
    padding-top: 26px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(11.5px, 0.26vw + 10.5px, 13px);
    letter-spacing: 0.06em;
    color: var(--text-4);
  }

  .hud-home {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--text-4);
    text-decoration: none;
  }

  .hud-home:hover {
    color: var(--text-2);
  }

  /* Stroked, not filled — a cut mark, matching the edit rune. One gold,
     spent once (§4). */
  .sigil {
    align-self: center;
    fill: none;
    stroke: var(--torch);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  nav {
    margin-inline-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  nav a {
    color: var(--text-4);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text-2);
  }

  button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: var(--text-4);
    display: flex;
    align-items: center;
    align-self: center; /* the nav is baseline-aligned; the icon is not */
    line-height: 1;
  }

  button:hover {
    color: var(--text-2);
  }

  /* The moon carries the HUD's own ink, so hollowed spends no gold on the
     control at all. The sun takes --torch — the one control §4 lets have
     it, for an active state. */
  .moon {
    fill: currentColor;
  }

  .sun {
    display: none;
  }

  .sun-core {
    fill: var(--torch);
  }

  .sun-ray {
    stroke: var(--torch);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  :root[data-theme="kindled"] .moon,
  :root[data-theme="light"] .moon {
    display: none;
  }

  :root[data-theme="kindled"] .sun,
  :root[data-theme="light"] .sun {
    display: block;
  }

  @media (max-width: 620px) {
    nav {
      margin-inline-start: 0;
      width: 100%;
      padding-top: 8px;
    }
  }
</style>
