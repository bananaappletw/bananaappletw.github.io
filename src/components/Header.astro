---
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy
// subdirectory. e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};

// The HUD carries the fewest words that still let a reader move. Souls
// affixes its interface to a corner and otherwise leaves the screen alone.
const links = [
  { href: "posts", label: t.nav.posts, path: "/posts" },
  { href: "tags", label: t.nav.tags, path: "/tags" },
  ...(features.showArchives
    ? [{ href: "archives", label: t.nav.archives, path: "/archives" }]
    : []),
  ...(features.search !== false
    ? [{ href: "search", label: t.nav.search, path: "/search" }]
    : []),
  { href: "list", label: t.nav.list, path: "/list" },
  { href: "about", label: t.nav.about, path: "/about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="label absolute inset-s-16 -top-full z-50 px-3 py-2 focus:top-4"
  style="background: var(--ground); color: var(--torch);"
>
  {t.a11y.skipToContent}
</a>

<header class="app-layout">
  <div class="hud">
    <a href={getRelativeLocaleUrl(locale, "")} class="hud-home">
      {/* The soul: the site's mark, and the page's one moving thing (§11). */}
      <svg
        class="soul flame"
        viewBox="0 0 16 16"
        width="14"
        height="14"
        aria-hidden="true"
        focusable="false"
      >
        <path
          class="soul-veil"
          d="M8 0.7c1.1 2.6.2 3.7.7 5.2-.9-.7-1.4-1.8-1.3-3-1.2 1.5-.9 2.9-.9 3.9C4.9 7.6 3.9 9 3.9 10.7c0 2.3 1.8 4.2 4.1 4.2s4.1-1.9 4.1-4.2c0-1.7-1-3.1-2.6-3.9.1-1.6-.4-3.4-1.5-6.1z"
        ></path>
        <ellipse class="soul-core" cx="8" cy="10.7" rx="1.7" ry="1.8"></ellipse>
      </svg>
      <span>{site.title}</span>
    </a>

    <nav aria-label={t.nav.posts}>
      {
        links.map(link => (
          <a
            href={getRelativeLocaleUrl(locale, link.href)}
            aria-current={isActive(link.path) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        features.lightAndDarkMode && (
          <button
            id="world-btn"
            type="button"
            aria-label="Dark theme. Switch to light."
          >
            {/* The torch: out when hollowed, lit when kindled. Static. */}
            <svg
              class="torch"
              viewBox="0 0 16 16"
              width="15"
              height="15"
              aria-hidden="true"
              focusable="false"
            >
              <path
                class="torch-fire"
                d="M8 1.1c1.3 2.8 3 3.8 3 6.4 0 2.1-1.3 3.6-3 3.6s-3-1.5-3-3.6c0-1.6.9-2.3 1.3-3.4.5 1.2 1.1.7 1.7-3z"
              />
              <path class="torch-haft" d="M7.3 11.4h1.4v3.5H7.3z" />
            </svg>
          </button>
        )
      }
    </nav>
  </div>
</header>

<style>
  .hud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 18px;
    padding-top: 26px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-4);
  }

  .hud-home {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--text-4);
    text-decoration: none;
  }

  .hud-home:hover {
    color: var(--text-2);
  }

  /* One colour at two opacities — veil is the glow, core is the soul.
     Two tones, one gold: the accent is still spent once (§4). */
  .hud .soul {
    align-self: center;
  }

  .soul-veil {
    fill: var(--torch);
    opacity: 0.42;
  }

  .soul-core {
    fill: var(--torch);
  }

  nav {
    margin-inline-start: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  nav a {
    color: var(--text-4);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--text-2);
  }

  button {
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    background: none;
    border: 0;
    padding: 0;
    color: var(--text-4);
    display: flex;
    align-items: center;
    align-self: center; /* the nav is baseline-aligned; the icon is not */
    line-height: 1;
  }

  button:hover {
    color: var(--text-2);
  }

  /* Out when hollowed, lit when kindled — the one control that takes gold,
     which §4 permits for an active state. The haft never lights. */
  .torch-fire {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .torch-haft {
    fill: currentColor;
  }

  :root[data-theme="kindled"] .torch-fire,
  :root[data-theme="light"] .torch-fire {
    fill: var(--torch);
    stroke: var(--torch);
  }

  @media (max-width: 620px) {
    nav {
      margin-inline-start: 0;
      width: 100%;
      padding-top: 8px;
    }
  }
</style>
