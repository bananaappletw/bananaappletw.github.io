---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <section class="gate">
    <h1>{pageTitle}</h1>
    {pageDesc && <p class="sub">{pageDesc}</p>}
  </section>

  <hr class="rule" />

  <div class="body"><slot /></div>
</main>

<style>
  .gate {
    padding-block: clamp(40px, 8vh, 80px) clamp(32px, 5vh, 56px);
  }

  .gate h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(28px, 4.4vw, 40px);
    line-height: 1.2;
    letter-spacing: 0.03em;
    font-variant-caps: small-caps;
    color: var(--text);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }

  .gate .sub {
    margin: clamp(20px, 3vh, 32px) 0 0;
    max-width: 48ch;
    color: var(--text-3);
    font-size: 16px;
    line-height: 1.8;
  }

  .body {
    padding-block: clamp(28px, 4vh, 48px) 0;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
