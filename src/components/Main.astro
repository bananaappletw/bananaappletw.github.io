---
type Props = {
  pageTitle: string | [string, string];
  class?: string;
};

const { pageTitle, class: className } = Astro.props;
---

<main id="main-content" class:list={["app-layout pb-4", className]}>
  <section class="gate">
    <h1>{pageTitle}</h1>
  </section>

  <hr class="rule" />

  <div class="body"><slot /></div>
</main>

<style>
  .gate {
    padding-block: clamp(40px, 8vh, 80px) clamp(32px, 5vh, 56px);
  }

  .gate h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 4.4vw, 40px);
    line-height: 1.2;
    letter-spacing: 0.03em;
    color: var(--text);
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }

  .body {
    padding-block: clamp(28px, 4vh, 48px) 0;
  }
</style>
