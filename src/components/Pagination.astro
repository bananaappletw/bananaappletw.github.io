---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);
---

{
  page.lastPage > 1 && (
    <nav
      class="pager app-layout"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      {page.url.prev ? (
        <a href={page.url.prev} aria-label={t.a11y.goToPreviousPage}>
          {t.pagination.prev}
        </a>
      ) : (
        <span class="spent">{t.pagination.prev}</span>
      )}

      <span class="count">
        {page.currentPage} / {page.lastPage}
      </span>

      {page.url.next ? (
        <a href={page.url.next} aria-label={t.a11y.goToNextPage}>
          {t.pagination.next}
        </a>
      ) : (
        <span class="spent">{t.pagination.next}</span>
      )}
    </nav>
  )
}

<style>
  /* Words, not chevrons. Souls names its directions. */
  .pager {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    padding-block: clamp(40px, 7vh, 72px) 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 12.5px;
    letter-spacing: 0.06em;
  }

  .pager a {
    color: var(--text-3);
    text-decoration: none;
  }

  .pager a:hover {
    color: var(--text);
  }

  .spent {
    color: var(--text-4);
    opacity: 0.45;
  }

  .count {
    color: var(--text-4);
    font-variant-numeric: tabular-nums;
  }
</style>
