---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);

const rssHref = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <hr class="rule" />
  <div class="foot">
    <span>
      {t.footer.copyright} &middot; {t.footer.allRightsReserved} &middot;
      <a href={rssHref}>RSS</a>
    </span>
    <Socials />
  </div>
</footer>

<style>
  footer {
    padding-block: clamp(70px, 12vh, 130px) 80px;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
    justify-content: space-between;
    align-items: center;
    padding-top: 22px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--text-4);
  }

  .foot a {
    color: var(--text-4);
    text-decoration: none;
  }

  .foot a:hover {
    color: var(--text-2);
  }
</style>
